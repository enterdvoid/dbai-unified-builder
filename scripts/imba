# 8.0 REAL WORLD SCENARIO
###############################################################################

if [[ "${RUN_REALWORLD:-0}" -eq 1 ]]; then
section "REAL WORLD SCENARIO"

subsection "File Locator"
EXPECTED_MP4_MD5="fb20ba0a7f531eabb345a5abcce33d78"
EXPECTED_ZIP_MD5="acc8d0b77517da4a9aebb64b3777a0d0"
FILE_URL="https://download.blender.org/demo/movies/BBB/bbb_sunflower_2160p_60fps_normal.mp4.zip"
MP4_NAME="bbb_sunflower_2160p_60fps_normal.mp4"
ZIP_NAME="bbb_sunflower_2160p_60fps_normal.mp4.zip"

TARGET_MP4=""
TARGET_ZIP=""

info "Target MP4" "$MP4_NAME"
info "Search paths" "\$PWD, /mnt/*, /media/*"

search_file() {
    local fname="$1"
    local fmd5="$2"
    local found_path=""
    if [[ -f "$PWD/$fname" ]]; then
        found_path="$PWD/$fname"
    else
        for d in /mnt /media; do
            [[ ! -d "$d" ]] && continue
            found=$(find "$d" -name "$fname" 2>/dev/null | head -n 1)
            if [[ -n "$found" ]]; then
                found_path="$found"
                break
            fi
        done
    fi
    
    if [[ -n "$found_path" ]]; then
        info "Found" "$found_path" >&2
        local hash=$(md5sum "$found_path" | awk '{print $1}')
        if [[ "$hash" == "$fmd5" ]]; then
            echo "$found_path"
            return 0
        else
            warn "MD5 mismatch for $found_path (expected: $fmd5, got: $hash)" >&2
        fi
    fi
    return 1
}

TARGET_MP4=$(search_file "$MP4_NAME" "$EXPECTED_MP4_MD5")
if [[ -z "$TARGET_MP4" ]]; then
    info "Status" "MP4 not found. Searching for ZIP..."
    TARGET_ZIP=$(search_file "$ZIP_NAME" "$EXPECTED_ZIP_MD5")
    if [[ -z "$TARGET_ZIP" ]]; then
        dl_dir="$PWD"
        if [[ -n "${USB_MNT_POINTS:-}" ]]; then
            for mnt in $USB_MNT_POINTS; do
                if [[ -d "$mnt" && -w "$mnt" ]]; then
                    dl_dir="$mnt"
                    break
                fi
            done
        fi
        
        info "Status" "ZIP not found. Downloading to $dl_dir..."
        
        TOTAL_BYTES=0
        if command -v curl >/dev/null 2>&1; then
            TOTAL_BYTES=$(curl -sI "$FILE_URL" | awk -v IGNORECASE=1 '/^Content-Length:/ {print $2}' | tr -d '\r' | grep -Eo '^[0-9]+' || echo 0)
        fi
        
        wget -q "$FILE_URL" -O "$dl_dir/$ZIP_NAME" &
        WGET_PID=$!
        
        while kill -0 $WGET_PID 2>/dev/null; do
            if [[ -f "$dl_dir/$ZIP_NAME" ]]; then
                curr_bytes=$(stat -c%s "$dl_dir/$ZIP_NAME" 2>/dev/null || echo 0)
                if [[ "$curr_bytes" -gt 0 ]]; then
                    if [[ "$TOTAL_BYTES" -gt 0 ]]; then
                        pct=$(( curr_bytes * 100 / TOTAL_BYTES ))
                        curr_mb=$(( curr_bytes / 1048576 ))
                        tot_mb=$(( TOTAL_BYTES / 1048576 ))
                        printf "\r| %-14s : %-41s |" "Status" "Downloading... ${pct}% (${curr_mb} MB / ${tot_mb} MB)"
                    else
                        curr_mb=$(( curr_bytes / 1048576 ))
                        printf "\r| %-14s : %-41s |" "Status" "Downloading... ${curr_mb} MB"
                    fi
                fi
            fi
            sleep 1
        done
        echo ""
        hash_val=$(md5sum "$dl_dir/$ZIP_NAME" | awk '{print $1}')
        if [[ "$hash_val" == "$EXPECTED_ZIP_MD5" ]]; then
            TARGET_ZIP="$dl_dir/$ZIP_NAME"
        else
            fail "Downloaded ZIP MD5 mismatch."
        fi
    fi
    
    if [[ -n "$TARGET_ZIP" ]]; then
        info "Status" "Extracting ZIP..."
        ZIP_DIR="$(dirname "$TARGET_ZIP")"
        unzip -q -o "$TARGET_ZIP" -d "$ZIP_DIR"
        mhash_val=$(md5sum "$ZIP_DIR/$MP4_NAME" | awk '{print $1}')
        if [[ "$mhash_val" == "$EXPECTED_MP4_MD5" ]]; then
            TARGET_MP4="$ZIP_DIR/$MP4_NAME"
        else
            fail "Extracted MP4 MD5 mismatch."
        fi
    fi
fi

if [[ -n "$TARGET_MP4" ]]; then
    ok "MP4 Source Ready: $TARGET_MP4"
    if [[ -z "$FFMPEG_OUT_DIR" ]]; then
        FFMPEG_OUT_DIR="$(dirname "$TARGET_MP4")"
    fi
    mkdir -p "$FFMPEG_OUT_DIR"
    
    start_cpu_monitor "realworld"

    subsection "Scenario A: 4K to 1080p H.264 (Multi-Core)"
    info "Source" "BBB 4K 2160p60, first 30s"
    info "Target" "1080p H.264 (preset: slow, $(nproc) threads)"
    info "Status" "Transcoding 30 seconds..."
    time_start=$(date +%s%N)
    
    FFMPEG_OUT_A="$FFMPEG_OUT_DIR/rw_video.mp4"
    ffmpeg -threads $(nproc) -filter_threads $(nproc) -i "$TARGET_MP4" -t 30 -vf scale=1920:1080 -c:v libx264 -preset slow -threads $(nproc) -y "$FFMPEG_OUT_A" 2> "$TEMP_ROOT/ff_a.log"
    
    time_end=$(date +%s%N)
    elapsed_a_ms=$(( (time_end - time_start) / 1000000 ))
    elapsed_a_sec=$(awk "BEGIN {print $elapsed_a_ms/1000}")
    
    fps_a=$(cat "$TEMP_ROOT/ff_a.log" | grep -o "fps=[^a-z]*" | tail -n 1 | awk '{print $1}' | awk -F'=' '{print $2}')
    [[ -z "$fps_a" ]] && fps_a="N/A"
    
    info "Video 4K->1080p" "${fps_a} FPS (${elapsed_a_sec}s)"
    echo "${fps_a}|${elapsed_a_sec}" > "$TEMP_ROOT/rw_video_res"

    subsection "Scenario B: Audio Extraction AAC (Single-Core)"
    info "Source" "BBB 4K 2160p60, first 60s"
    info "Target" "AAC 192kbps (single-core)"
    info "Status" "Transcoding audio 60 seconds..."
    time_start=$(date +%s%N)
    
    FFMPEG_OUT_B="$FFMPEG_OUT_DIR/rw_audio.aac"
    ffmpeg -i "$TARGET_MP4" -t 60 -vn -c:a aac -b:a 192k -y "$FFMPEG_OUT_B" 2> "$TEMP_ROOT/ff_b.log"
    
    time_end=$(date +%s%N)
    elapsed_b_ms=$(( (time_end - time_start) / 1000000 ))
    elapsed_b_sec=$(awk "BEGIN {print $elapsed_b_ms/1000}")
    
    speed_b=$(cat "$TEMP_ROOT/ff_b.log" | grep -o "speed=[^ ]*" | tail -n 1 | awk -F'=' '{print $2}')
    [[ -z "$speed_b" ]] && speed_b="N/A"
    
    info "Audio Extraction" "${speed_b} speed (${elapsed_b_sec}s)"
    echo "${speed_b}|${elapsed_b_sec}" > "$TEMP_ROOT/rw_audio_res"

    stop_cpu_monitor
    print_monitor_summary "$MONITOR_FILE"

    rm -f "$FFMPEG_OUT_A" "$FFMPEG_OUT_B"
else
    fail "Unable to acquire test video."
    echo "FAILED|FAILED" > "$TEMP_ROOT/rw_video_res"
    echo "FAILED|FAILED" > "$TEMP_ROOT/rw_audio_res"
fi

section_end
print_cpu_monitor "$TEMP_ROOT/realworld_monitor.txt"
fi

###############################################################################
# 7. IMBA SUMMARY
###############################################################################

section "IMBA SUMMARY"

SINGLE_SCORE="$(cat "$TEMP_ROOT/single_score" 2>/dev/null || echo "")"
ALL_SCORE="$(cat "$TEMP_ROOT/all_score" 2>/dev/null || echo "")"
SCALE="$(cat "$TEMP_ROOT/cpu_scale" 2>/dev/null || echo "")"
EFFICIENCY="$(cat "$TEMP_ROOT/cpu_efficiency" 2>/dev/null || echo "")"

MEM_READ="$(cat "$TEMP_ROOT/mem_read" 2>/dev/null || echo "")"
MEM_WRITE="$(cat "$TEMP_ROOT/mem_write" 2>/dev/null || echo "")"

FILE_READ="$(cat "$TEMP_ROOT/file_read_iops" 2>/dev/null || echo "")"
FILE_WRITE="$(cat "$TEMP_ROOT/file_write_iops" 2>/dev/null || echo "")"
FILE_READ_MB="$(cat "$TEMP_ROOT/file_read_mibs" 2>/dev/null || echo "")"
FILE_WRITE_MB="$(cat "$TEMP_ROOT/file_write_mibs" 2>/dev/null || echo "")"

FIO_SEQ="$(cat "$TEMP_ROOT/fio_seq" 2>/dev/null || echo "")"
FIO_RND_QD1="$(cat "$TEMP_ROOT/fio_qd1" 2>/dev/null || echo "")"
FIO_RND_QD32="$(cat "$TEMP_ROOT/fio_qd32" 2>/dev/null || echo "")"

THREADS_SCORE="$(cat "$TEMP_ROOT/threads_score" 2>/dev/null || echo "")"
MUTEX_SCORE="$(cat "$TEMP_ROOT/mutex_score" 2>/dev/null || echo "")"

NET_LOCAL="$(cat "$TEMP_ROOT/net_local" 2>/dev/null || echo "")"
NET_DL="$(cat "$TEMP_ROOT/net_down" 2>/dev/null || echo "")"
NET_UL="$(cat "$TEMP_ROOT/net_up" 2>/dev/null || echo "")"
NET_ST_DL="$(cat "$TEMP_ROOT/net_st_dl" 2>/dev/null || echo "")"
NET_ST_UL="$(cat "$TEMP_ROOT/net_st_ul" 2>/dev/null || echo "")"
NET_ST_ISP="$(cat "$TEMP_ROOT/net_st_isp" 2>/dev/null || echo "")"
NET_ST_SERVER="$(cat "$TEMP_ROOT/net_st_server" 2>/dev/null || echo "")"
NET_ST_URL="$(cat "$TEMP_ROOT/net_st_url" 2>/dev/null || echo "")"
NET_WIFI_CYCLE="$(cat "$TEMP_ROOT/net_wifi_cycle" 2>/dev/null || echo "")"

if [[ "$RUN_CPU" -eq 1 ]]; then
    subsection "[ CPU ]"
if [[ -n "$SINGLE_SCORE" ]]; then info "Single Core" "$SINGLE_SCORE events/s"; else info "Single Core" "N/A"; fi
if [[ -n "$ALL_SCORE" ]]; then info "All Core" "$ALL_SCORE events/s"; else info "All Core" "N/A"; fi
if [[ -n "$SCALE" ]]; then info "Scaling" "${SCALE}x"; fi
if [[ -n "$EFFICIENCY" ]]; then info "Linear Efficiency" "${EFFICIENCY}%"; fi

# Per-cluster scores (big.LITTLE)
for label_file in "$TEMP_ROOT"/cluster_*_score; do
    [[ -f "$label_file" ]] || continue
    cl_label="$(basename "$label_file" | sed 's/cluster_//;s/_score//')"
    cl_score="$(cat "$label_file" 2>/dev/null || echo "")"
    if [[ -n "$cl_score" ]]; then
        info "Core ($cl_label)" "$cl_score events/s"
    fi
done

# Real clockspeed results
if [[ -f "$TEMP_ROOT/mhz_results.txt" ]]; then
    while IFS=: read -r mhz_label mhz_os mhz_real; do
        info "Clock ($mhz_label)" "OS: ${mhz_os} MHz / Real: ${mhz_real} MHz"
    done < "$TEMP_ROOT/mhz_results.txt"
fi

if [[ -n "$THREADS_SCORE" ]]; then info "Threads" "$THREADS_SCORE events/s"; else info "Threads" "N/A"; fi
if [[ -n "$MUTEX_SCORE" ]]; then info "Mutex" "$MUTEX_SCORE events/s"; else info "Mutex" "N/A"; fi

fi

if [[ "$RUN_MEM" -eq 1 ]]; then
    subsection "[ MEMORY ]"
if [[ -n "$MEM_READ" ]]; then info "Memory Read" "$MEM_READ MiB/s"; else info "Memory Read" "N/A"; fi
if [[ -n "$MEM_WRITE" ]]; then info "Memory Write" "$MEM_WRITE MiB/s"; else info "Memory Write" "N/A"; fi

fi

if [[ "$RUN_STORAGE" -eq 1 ]]; then
    subsection "[ STORAGE ]"
for f in "$TEMP_ROOT"/storage_result_*; do
    [[ -f "$f" ]] || continue
    bn="$(basename "$f" | sed 's/storage_result_//')"
    IFS="|" read -r dev_type model size seq_val qd1_val qd32_val write_val < "$f"
    info "$dev_type ($bn)" "$model ($size)"
    info "  Seq Read" "$seq_val"
    info "  Rand 4K QD1" "$qd1_val"
    info "  Rand 4K QD32" "$qd32_val"
    info "  File I/O Random" "$write_val"
done

fi

NET_IFACE="$(cat "$TEMP_ROOT/net_iface" 2>/dev/null || echo "unknown")"

if [[ "$RUN_NET" -eq 1 ]]; then
    subsection "[ NETWORK ]"
if [[ -n "$NET_LOCAL" ]]; then info "Loopback TCP" "$NET_LOCAL"; else info "Loopback TCP" "SKIPPED"; fi
if [[ -n "$NET_DL" ]]; then info "TCP DL ($NET_IFACE)" "$NET_DL"; else info "TCP DL" "SKIPPED"; fi
if [[ -n "$NET_UL" ]]; then info "TCP UL ($NET_IFACE)" "$NET_UL"; else info "TCP UL" "SKIPPED"; fi

fi

if [[ -n "$NET_ST_DL" || "$RUN_SPEEDTEST" -eq 1 ]]; then
    subsection "[ INTERNET ]"
    if [[ -n "$NET_ST_DL" ]]; then info "Speedtest DL" "$NET_ST_DL"; fi
    if [[ -n "$NET_ST_UL" ]]; then info "Speedtest UL" "$NET_ST_UL"; fi
    if [[ -n "$NET_ST_ISP" ]]; then info "Speedtest ISP" "$NET_ST_ISP"; fi
    if [[ -n "$NET_ST_SERVER" ]]; then info "Speedtest Server" "$NET_ST_SERVER"; fi
    if [[ -n "$NET_ST_URL" ]]; then info "Speedtest URL" "$NET_ST_URL"; fi
fi

if [[ -n "$NET_WIFI_CYCLE" ]]; then
    subsection "[ WIFI CYCLE ]"
    while IFS= read -r line; do
        info "WiFi Cycle" "$line"
    done <<< "$NET_WIFI_CYCLE"
fi

if [[ "$RUN_REALWORLD" -eq 1 ]]; then
    subsection "[ REAL WORLD (FFmpeg) ]"
if [[ -f "$TEMP_ROOT/rw_video_res" ]]; then
    IFS="|" read -r v_fps v_time < "$TEMP_ROOT/rw_video_res"
    info "Video 4K -> 1080p H.264" "${v_fps} FPS (Time: ${v_time}s)"
else
    info "Video 4K -> 1080p H.264" "SKIPPED"
