#!/usr/bin/env bash

###############################################################################
# IMBA v0.5.0
# TV BOX / SBC BENCHMARK
#
# Designed for:
#   - ARM SBC
#   - TV Box / STB
#   - Debian / Ubuntu / Armbian
#
# Core benchmarks:
#   CPU single core
#   CPU all cores
#   CPU threads
#   CPU mutex
#   CPU temperature & frequency
#   Memory read/write
#   Filesystem I/O
#   Raw storage read
#
# Hardware information:
#   CPU
#   RAM / Swap
#   Storage
#   MMC
#   Network
#
# Optional:
#   iperf3 network benchmark when IMBA_IPERF_SERVER is provided
#
# IMPORTANT:
#   Raw storage benchmark is READ ONLY.
#   USB storage benchmark is READ ONLY.
#   IMBA does not modify CPU governor or swap configuration.
###############################################################################

set -u
set -o pipefail

SCREEN_NAME="imba666"
if command -v screen >/dev/null 2>&1; then
    if [[ "${STY:-}" != *"$SCREEN_NAME"* ]]; then
        if screen -list | grep -q "\.${SCREEN_NAME}[[:space:]]"; then
            echo "[INFO] Attaching to existing screen session: $SCREEN_NAME"
            exec screen -x "$SCREEN_NAME"
        else
            echo "[INFO] Starting IMBA in a new screen session: $SCREEN_NAME"
            exec screen -S "$SCREEN_NAME" bash "$0" "$@"
        fi
    fi
fi

###############################################################################
# CONFIGURATION
###############################################################################

IMBA_VERSION="1.0"

CPU_DURATION=60
MEMORY_DURATION=60
THREAD_DURATION=60
FILEIO_DURATION=60

TEMP_INTERVAL=5
FREQ_INTERVAL=5

FILEIO_SIZE="1G"
FILEIO_DIR="/var/tmp/imba-fileio"

FIO_SIZE="1G"
FIO_BS="1M"

MEMORY_TOTAL_SIZE="1T"
MEMORY_BLOCK="1M"

DISK_SAFETY_MARGIN_MB=512

MUTEX_LOCKS=10000000
MUTEX_LOOPS=1000
MUTEX_NUM=4096

###############################################################################
# CONFIG FILE (imba.conf)
###############################################################################
CONF_FILE="$PWD/imba.conf"
if [[ -f "$CONF_FILE" ]]; then
    source "$CONF_FILE"
else
    cat <<EOF > "$CONF_FILE"
# IMBA Configuration File
# Fill these to skip whiptail prompts when running all benchmarks.

IPERF_SERVER=""
FFMPEG_OUT_DIR=""
ST_SERVER_ID=""

HA_URL=""
HA_TOKEN=""
HA_POWER_ENTITY=""
EOF
fi

PROMPT_FILE="$PWD/imba.prompt"

save_config_var() {
    local key="$1"
    local val="$2"
    if [[ -f "$CONF_FILE" ]]; then
        local escaped_val="$(echo "$val" | sed 's/[/&|]/\\&/g')"
        sed -i "s|^${key}=.*|${key}=\"${escaped_val}\"|" "$CONF_FILE"
    fi
}

IPERF_SERVER="${IMBA_IPERF_SERVER:-${IPERF_SERVER:-}}"
HA_URL="${IMBA_HA_URL:-${HA_URL:-}}"
HA_TOKEN="${IMBA_HA_TOKEN:-${HA_TOKEN:-}}"
HA_POWER_ENTITY="${IMBA_HA_POWER_ENTITY:-${HA_POWER_ENTITY:-}}"
POWER_MONITOR_ENABLED=0

###############################################################################
# ROOT CHECK
###############################################################################

if [[ "${EUID}" -ne 0 ]]; then
    exec sudo IMBA_IPERF_SERVER="${IMBA_IPERF_SERVER:-}" \
              IMBA_HA_URL="${IMBA_HA_URL:-}" \
              IMBA_HA_TOKEN="${IMBA_HA_TOKEN:-}" \
              IMBA_HA_POWER_ENTITY="${IMBA_HA_POWER_ENTITY:-}" \
              bash "$0" "$@"
fi

# CLI Argument Parser
WANT_CPU=0
WANT_MEM=0
WANT_STORAGE=0
WANT_NET=0
WANT_REALWORLD=0
RUN_STRESS=0
RUN_SPEEDTEST=0
EXPORT_JSON=0
JSON_FILE=""
FFMPEG_OUT_DIR=""
HAS_FILTER=0
WANT_MENU=0
WANT_ALL=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cpu-only) WANT_CPU=1; HAS_FILTER=1; shift ;;
        --memory-only) WANT_MEM=1; HAS_FILTER=1; shift ;;
        --storage-only) WANT_STORAGE=1; HAS_FILTER=1; shift ;;
        --network-only) WANT_NET=1; HAS_FILTER=1; shift ;;
        --realworld-only) WANT_REALWORLD=1; HAS_FILTER=1; shift ;;
        --speedtest) RUN_SPEEDTEST=1; shift ;;
        --stress) RUN_STRESS=1; shift ;;
        --json) EXPORT_JSON=1; shift ;;
        --menu) WANT_MENU=1; shift ;;
        --all) WANT_ALL=1; HAS_FILTER=1; shift ;;
        --iperf3-server)
            IPERF_SERVER="$2"
            export IMBA_IPERF_SERVER="$2"
            shift 2
            ;;
        --speedtest-server)
            ST_SERVER_ID="$2"
            shift 2
            ;;
        *) shift ;;
    esac
done

if [[ "$HAS_FILTER" -eq 0 && "${WANT_ALL:-0}" -eq 0 ]]; then
    WANT_MENU=1
fi

if [[ "${WANT_MENU:-0}" -eq 1 ]] && command -v whiptail >/dev/null 2>&1; then
    CHOICES=$(whiptail --title "IMBA Benchmark Suite" --checklist \
        "Select the benchmarks you want to run:" 20 60 9 \
        "CPU" "CPU, Threads, and Mutex tests" ON \
        "Memory" "RAM Read and Write tests" ON \
        "Storage" "File I/O and SD/USB tests" ON \
        "Network" "Local loopback and iperf3 tests" ON \
        "Speedtest" "Ookla Internet Speedtest" ON \
        "RealWorld" "FFmpeg Transcoding Benchmarks" ON \
        "Stress" "15-min Thermal Throttling Test" OFF \
        "Power" "AC Wall Power via Home Assistant" OFF \
        "JSON" "Export results to JSON file" ON 3>&1 1>&2 2>&3)
    if [ $? -eq 0 ]; then
        HAS_FILTER=1
        WANT_CPU=0; WANT_MEM=0; WANT_STORAGE=0; WANT_NET=0; RUN_STRESS=0; RUN_SPEEDTEST=0; WANT_REALWORLD=0
        [[ "$CHOICES" == *"\"CPU\""* ]] && WANT_CPU=1
        [[ "$CHOICES" == *"\"Memory\""* ]] && WANT_MEM=1
        [[ "$CHOICES" == *"\"Storage\""* ]] && WANT_STORAGE=1
        [[ "$CHOICES" == *"\"Network\""* ]] && WANT_NET=1
        [[ "$CHOICES" == *"\"RealWorld\""* ]] && WANT_REALWORLD=1
        [[ "$CHOICES" == *"\"Speedtest\""* ]] && RUN_SPEEDTEST=1
        [[ "$CHOICES" == *"\"Stress\""* ]] && RUN_STRESS=1
        [[ "$CHOICES" == *"\"JSON\""* ]] && EXPORT_JSON=1

        if [[ "$WANT_NET" -eq 1 ]]; then
            if [[ -z "$IPERF_SERVER" ]]; then
                IP_INPUT=$(whiptail --title "Network Benchmark" --inputbox "Enter iperf3 server IP (e.g. 192.168.2.208, leave blank to skip):" 10 70 "${IPERF_SERVER:-}" 3>&1 1>&2 2>&3)
                if [ $? -eq 0 ] && [ -n "$IP_INPUT" ]; then
                    IPERF_SERVER="$IP_INPUT"
                    export IMBA_IPERF_SERVER="$IP_INPUT"
                    save_config_var "IPERF_SERVER" "$IP_INPUT"
                fi
            else
                export IMBA_IPERF_SERVER="$IPERF_SERVER"
            fi
        fi

        if [[ "$WANT_REALWORLD" -eq 1 ]]; then
            if [[ -z "$FFMPEG_OUT_DIR" ]]; then
                RW_INPUT=$(whiptail --title "Real World Benchmark" --inputbox "Enter FFmpeg custom output directory (leave blank to use Source Directory):" 10 70 "${FFMPEG_OUT_DIR:-}" 3>&1 1>&2 2>&3)
                if [ $? -eq 0 ]; then
                    [[ -z "$RW_INPUT" ]] && FFMPEG_OUT_DIR="" || FFMPEG_OUT_DIR="$RW_INPUT"
                    save_config_var "FFMPEG_OUT_DIR" "$FFMPEG_OUT_DIR"
                fi
            fi
        fi

        if [[ "$RUN_SPEEDTEST" -eq 1 ]]; then
            if [[ -z "$ST_SERVER_ID" ]]; then
                ST_INPUT=$(whiptail --title "Speedtest Benchmark" --inputbox "Enter Speedtest Server ID (e.g. 30400 JKT, 61853 SBY, leave blank for auto):" 10 70 "${ST_SERVER_ID:-}" 3>&1 1>&2 2>&3)
                if [ $? -eq 0 ] && [ -n "$ST_INPUT" ]; then
                    ST_SERVER_ID="$ST_INPUT"
                    save_config_var "ST_SERVER_ID" "$ST_INPUT"
                fi
            fi
        fi

        if [[ "$CHOICES" == *"\"Power\""* ]]; then
            if [[ -z "$HA_URL" || -z "$HA_TOKEN" || -z "$HA_POWER_ENTITY" ]]; then
                HA_URL_INPUT=$(whiptail --title "Power Monitor - Home Assistant" --inputbox \
                    "Enter Home Assistant URL (e.g. http://192.168.2.152):" \
                    10 70 "${HA_URL:-}" 3>&1 1>&2 2>&3)
                if [ $? -eq 0 ] && [ -n "$HA_URL_INPUT" ]; then
                    HA_URL="$HA_URL_INPUT"
                    export IMBA_HA_URL="$HA_URL_INPUT"

                    HA_TOKEN_INPUT=$(whiptail --title "Power Monitor - Home Assistant" --passwordbox \
                        "Enter Home Assistant Long-Lived Access Token:" \
                        10 70 "${HA_TOKEN:-}" 3>&1 1>&2 2>&3)
                    if [ $? -eq 0 ] && [ -n "$HA_TOKEN_INPUT" ]; then
                        HA_TOKEN="$HA_TOKEN_INPUT"
                        export IMBA_HA_TOKEN="$HA_TOKEN_INPUT"

                        HA_ENTITY_INPUT=$(whiptail --title "Power Monitor - Home Assistant" --inputbox \
                            "Enter Power Entity ID (e.g. sensor.tapo_p110_current_consumption):" \
                            10 70 "${HA_POWER_ENTITY:-sensor.tapo_p110_current_consumption}" 3>&1 1>&2 2>&3)
                        if [ $? -eq 0 ] && [ -n "$HA_ENTITY_INPUT" ]; then
                            HA_POWER_ENTITY="$HA_ENTITY_INPUT"
                            export IMBA_HA_POWER_ENTITY="$HA_ENTITY_INPUT"
                            save_config_var "HA_URL" "$HA_URL"
                            save_config_var "HA_TOKEN" "$HA_TOKEN"
                            save_config_var "HA_POWER_ENTITY" "$HA_POWER_ENTITY"
                        fi
                    fi
                fi
            else
                export IMBA_HA_URL="$HA_URL"
                export IMBA_HA_TOKEN="$HA_TOKEN"
                export IMBA_HA_POWER_ENTITY="$HA_POWER_ENTITY"
            fi
        fi
    else
        echo "Cancelled."
        exit 0
    fi
    clear
fi

if [[ "$HAS_FILTER" -eq 1 ]]; then
    RUN_CPU="$WANT_CPU"
    RUN_MEM="$WANT_MEM"
    RUN_STORAGE="$WANT_STORAGE"
    RUN_NET="$WANT_NET"
    RUN_REALWORLD="$WANT_REALWORLD"
else
    RUN_CPU=1; RUN_MEM=1; RUN_STORAGE=1; RUN_NET=1; RUN_REALWORLD=1
fi

# FFMPEG_OUT_DIR fallback is handled in the Real World execution block

# Determine test label for filename
TEST_COUNT=$(( RUN_CPU + RUN_MEM + RUN_STORAGE + RUN_NET + RUN_REALWORLD + RUN_SPEEDTEST + RUN_STRESS ))
BENCH_LABEL=""
if [[ "$TEST_COUNT" -eq 1 ]]; then
    [[ "$RUN_CPU" -eq 1 ]] && BENCH_LABEL="-cpu"
    [[ "$RUN_MEM" -eq 1 ]] && BENCH_LABEL="-memory"
    [[ "$RUN_STORAGE" -eq 1 ]] && BENCH_LABEL="-storage"
    [[ "$RUN_NET" -eq 1 ]] && BENCH_LABEL="-network"
    [[ "$RUN_REALWORLD" -eq 1 ]] && BENCH_LABEL="-real_world"
    [[ "$RUN_SPEEDTEST" -eq 1 ]] && BENCH_LABEL="-speedtest"
    [[ "$RUN_STRESS" -eq 1 ]] && BENCH_LABEL="-stress"
fi

###############################################################################
# DEVICE INFORMATION
###############################################################################

DEVICE_MODEL="Unknown Device"
SOC_NAME="Unknown SoC"
if [[ -r /proc/device-tree/model ]]; then
    DEVICE_MODEL="$(tr -d '\0' < /proc/device-tree/model)"
fi
# 1. Base Detection via Device Tree Compatible
if [[ -r /proc/device-tree/compatible ]]; then
    COMPAT="$(tr -d '\0' < /proc/device-tree/compatible)"
    if [[ "$COMPAT" == *"bcm2712"* ]]; then SOC_NAME="Broadcom BCM2712 (Raspberry Pi 5)"; fi
    if [[ "$COMPAT" == *"bcm2711"* ]]; then SOC_NAME="Broadcom BCM2711 (Raspberry Pi 4)"; fi
    if [[ "$COMPAT" == *"bcm2837"* ]]; then SOC_NAME="Broadcom BCM2837 (Raspberry Pi 3)"; fi
    if [[ "$COMPAT" == *"bcm2836"* ]]; then SOC_NAME="Broadcom BCM2836 (Raspberry Pi 2)"; fi
    if [[ "$COMPAT" == *"bcm2835"* ]]; then SOC_NAME="Broadcom BCM2835 (Raspberry Pi 1/Zero)"; fi
    
    if [[ "$COMPAT" == *"rk3588"* || "$COMPAT" == *"rk3588s"* ]]; then SOC_NAME="Rockchip RK3588/S"; fi
    if [[ "$COMPAT" == *"rk3568"* ]]; then SOC_NAME="Rockchip RK3568"; fi
    if [[ "$COMPAT" == *"rk3566"* ]]; then SOC_NAME="Rockchip RK3566"; fi
    if [[ "$COMPAT" == *"rk3399"* ]]; then SOC_NAME="Rockchip RK3399"; fi
    if [[ "$COMPAT" == *"rk3328"* ]]; then SOC_NAME="Rockchip RK3328"; fi
    if [[ "$COMPAT" == *"rk3288"* ]]; then SOC_NAME="Rockchip RK3288"; fi
    if [[ "$COMPAT" == *"rk3229"* || "$COMPAT" == *"rk3228"* || "$COMPAT" == *"rk322x"* ]]; then SOC_NAME="Rockchip RK322x"; fi
    if [[ "$COMPAT" == *"rk3128"* ]]; then SOC_NAME="Rockchip RK3128"; fi
    
    if [[ "$COMPAT" == *"sun50i-h618"* ]]; then SOC_NAME="Allwinner H618"; fi
    if [[ "$COMPAT" == *"sun50i-h616"* ]]; then SOC_NAME="Allwinner H616"; fi
    if [[ "$COMPAT" == *"sun50i-h6"* ]]; then SOC_NAME="Allwinner H6"; fi
    if [[ "$COMPAT" == *"sun50i-h5"* ]]; then SOC_NAME="Allwinner H5"; fi
    if [[ "$COMPAT" == *"sun50i-a64"* ]]; then SOC_NAME="Allwinner A64"; fi
    if [[ "$COMPAT" == *"sun8i-h3"* ]]; then SOC_NAME="Allwinner H3"; fi
    if [[ "$COMPAT" == *"sun8i-h2-plus"* ]]; then SOC_NAME="Allwinner H2+"; fi
    
    if [[ "$COMPAT" == *"amlogic,s4"* || "$COMPAT" == *"s905w2"* || "$COMPAT" == *"s905y4"* ]]; then SOC_NAME="Amlogic S905W2/Y4"; fi
    if [[ "$COMPAT" == *"amlogic,sc2"* || "$COMPAT" == *"s905x4"* ]]; then SOC_NAME="Amlogic S905X4"; fi
    if [[ "$COMPAT" == *"amlogic,g12b"* || "$COMPAT" == *"s922x"* ]]; then SOC_NAME="Amlogic S922X/A311D"; fi
    if [[ "$COMPAT" == *"amlogic,sm1"* || "$COMPAT" == *"s905x3"* ]]; then SOC_NAME="Amlogic S905X3"; fi
    if [[ "$COMPAT" == *"amlogic,g12a"* || "$COMPAT" == *"s905x2"* || "$COMPAT" == *"s905y2"* ]]; then SOC_NAME="Amlogic S905X2/Y2"; fi
    if [[ "$COMPAT" == *"amlogic,gxm"* || "$COMPAT" == *"s912"* ]]; then SOC_NAME="Amlogic S912"; fi
    if [[ "$COMPAT" == *"amlogic,gxl"* || "$COMPAT" == *"s905x"* || "$COMPAT" == *"s905d"* || "$COMPAT" == *"s905w"* ]]; then SOC_NAME="Amlogic S905X/W/D"; fi
    if [[ "$COMPAT" == *"amlogic,gxbb"* || "$COMPAT" == *"s905"* ]]; then SOC_NAME="Amlogic S905"; fi
    if [[ "$COMPAT" == *"amlogic,meson8b"* || "$COMPAT" == *"s805"* ]]; then SOC_NAME="Amlogic S805"; fi
fi
[[ -z "$DEVICE_MODEL" ]] && DEVICE_MODEL="Unknown Device"


SAFE_DEVICE_NAME="$(
    echo "$DEVICE_MODEL" |
    tr '[:space:]' '_' |
    tr -cd '[:alnum:]_.-' |
    sed 's/_\{2,\}/_/g'
)"
[[ -z "$SAFE_DEVICE_NAME" ]] && SAFE_DEVICE_NAME="Unknown_Device"

HOSTNAME_VALUE="$(hostname 2>/dev/null || echo unknown)"
DATE_DISPLAY="$(date '+%a %b %d %I:%M:%S %p %Z %Y')"
DATE_FILE="$(date '+%Y-%m-%d-%H-%M-%S')"
SCRIPT_START_TIME=$(date +%s)

EXPORT_DIR="$(pwd)/imba_exports"
mkdir -p "$EXPORT_DIR" 2>/dev/null || true
LOG_FILE="${EXPORT_DIR}/imba${BENCH_LABEL}_${SAFE_DEVICE_NAME}_${DATE_FILE}.log"

###############################################################################
# LOGGING
###############################################################################

exec > >(tee -a "$LOG_FILE") 2>&1

print_banner() {
    cat << "EOF"

 ________  ___ __ __    _______   ________      
/_______/\/__//_//_/\ /_______/\ /_______/\     
\__.::._\/\::\| \| \ \\::: _  \ \\::: _  \ \    
   \::\ \  \:.      \ \\::(_)  \/_\::(_)  \ \   
   _\::\ \__\:.\-/\  \ \\::  _  \ \\:: __  \ \  
  /__\::\__/\\. \  \  \ \\::(_)  \ \\:.\ \  \ \ 
  \________\/ \__\/ \__\/ \_______\/ \__\/\__\/ 
EOF
    echo "   Integrated Multi-Benchmark Analyzer v${IMBA_VERSION}"
    echo "                     by DBAI"
}

print_banner

###############################################################################
# OUTPUT HELPERS
###############################################################################

C_GREEN="\e[32m"
C_YELLOW="\e[33m"
C_RED="\e[31m"
C_CYAN="\e[36m"
C_RESET="\e[0m"

section() {
    echo
    local title="$1"
    local title_len=${#title}
    local dash_count=$(( 60 - 3 - title_len ))
    local dashes=""
    for ((i=0; i<dash_count; i++)); do dashes="${dashes}-"; done
    printf "${C_CYAN}+- ${title} ${dashes}+${C_RESET}\n"
    SECTION_START_TIME=$(date +%s)
}

section_end() {
    local end_time=$(date +%s)
    local elapsed=$(( end_time - SECTION_START_TIME ))
    local m=$(( elapsed / 60 ))
    local s=$(( elapsed % 60 ))
    printf "${C_CYAN}| %-43s %14s |${C_RESET}\n" " " "Time: ${m}m ${s}s"
    printf "${C_CYAN}+------------------------------------------------------------+${C_RESET}\n"
}

print_boxed() {
    local text="$1"
    local color="${2:-}"
    local max_len=58
    local reset=""
    
    if [[ -n "$color" ]]; then reset="$C_RESET"; fi
    
    if [[ -z "$text" ]]; then
        printf "${color}| %*s |${reset}\n" "$max_len" ""
        return
    fi
    
    echo "$text" | fold -s -w "$max_len" | while IFS= read -r line; do
        # Remove trailing spaces so padding is accurate
        line="${line%"${line##*[![:space:]]}"}"
        local len=${#line}
        local pad=$(( max_len - len ))
        (( pad < 0 )) && pad=0
        printf "${color}| %s%*s |${reset}\n" "$line" "$pad" ""
    done
}

subsection() {
    print_boxed ""
    print_boxed "$1"
}

info() {
    local label="$1"
    local value="$2"
    local label_len=${#label}
    local col_width=14
    if (( label_len > col_width )); then
        col_width=$label_len
    fi

    # max_len in print_boxed is 58.
    # The prefix "label : " takes col_width + 3 characters.
    # We add +1 to max_val_len here so it hits 62 total chars perfectly.
    local max_val_len=$(( 59 - col_width - 3 ))

    if (( ${#value} <= max_val_len )); then
        local text
        text=$(printf "%-${col_width}s : %-${max_val_len}s" "$label" "$value")
        print_boxed "$text"
    else
        local first=1
        while (( ${#value} > 0 )); do
            local chunk="${value:0:$max_val_len}"
            value="${value:$max_val_len}"
            
            if [[ "$first" -eq 1 ]]; then
                local text
                text=$(printf "%-${col_width}s : %-${max_val_len}s" "$label" "$chunk")
                print_boxed "$text"
                first=0
            else
                local text
                text=$(printf "%-${col_width}s   %-${max_val_len}s" "" "$chunk")
                print_boxed "$text"
            fi
        done
    fi
}

ok() {
    print_boxed "[OK] $*" "$C_GREEN"
}

warn() {
    print_boxed "[WARNING] $*" "$C_YELLOW"
}

skip() {
    print_boxed "[SKIPPED] $*" "$C_YELLOW"
}

fail() {
    print_boxed "[FAILED] $*" "$C_RED"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

###############################################################################
# TEMPORARY FILES & CLEANUP
###############################################################################

TEMP_ROOT="/var/tmp/imba-runtime"
mkdir -p "$TEMP_ROOT"
USB_MNT_POINTS=""

cleanup() {
    if [[ -n "${USB_MNT_POINTS:-}" ]]; then
        for mp in ${USB_MNT_POINTS:-}; do
            umount "$mp" 2>/dev/null || true
            rmdir "$mp" 2>/dev/null || true
        done
    fi
    rm -rf "$TEMP_ROOT" 2>/dev/null || true
    if [[ -d "$FILEIO_DIR" ]]; then
        rm -rf "$FILEIO_DIR" 2>/dev/null || true
    fi
    if command_exists sed; then
        SED_ESC=$(printf '\033')
        sed -i "s/${SED_ESC}\[[0-9;]*m//g" "$LOG_FILE" 2>/dev/null || true
    fi
}

trap cleanup EXIT INT TERM

###############################################################################
# DEPENDENCY CHECK (Silent if all installed)
###############################################################################

APT_UPDATED=0
DEPENDENCY_FAILED=0
SECTION_DEPENDENCY_PRINTED=0

install_package_for_command() {
    local command_name="$1"
    local package_name="$2"

    if command_exists "$command_name"; then
        return 0
    fi

    if [[ "$SECTION_DEPENDENCY_PRINTED" -eq 0 ]]; then
        section "DEPENDENCY CHECK"
        SECTION_DEPENDENCY_PRINTED=1
    fi
    warn "Missing dependency: $command_name"
    info "Installing" "$package_name..."
    if [[ "$APT_UPDATED" -eq 0 ]]; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq >/dev/null 2>&1
        if [[ "$?" -ne 0 ]]; then
            fail "apt-get update failed."
            return 1
        fi
        APT_UPDATED=1
    fi

    export DEBIAN_FRONTEND=noninteractive
    apt-get install -y -qq "$package_name" >/dev/null 2>&1

    if command_exists "$command_name"; then
        ok "$package_name installed."
        return 0
    fi

    fail "Unable to install $package_name."
    return 1
}

install_package_for_command screen screen || DEPENDENCY_FAILED=1
install_package_for_command hexdump bsdmainutils || DEPENDENCY_FAILED=1
install_package_for_command sysbench sysbench || DEPENDENCY_FAILED=1
install_package_for_command fio fio || DEPENDENCY_FAILED=1
install_package_for_command lsblk util-linux || DEPENDENCY_FAILED=1
install_package_for_command ntfs-3g ntfs-3g || DEPENDENCY_FAILED=1

if [[ "${RUN_REALWORLD:-0}" -eq 1 ]]; then
    install_package_for_command ffmpeg ffmpeg || DEPENDENCY_FAILED=1
    install_package_for_command unzip unzip || DEPENDENCY_FAILED=1
    install_package_for_command wget wget || DEPENDENCY_FAILED=1
fi
install_package_for_command blkid util-linux || DEPENDENCY_FAILED=1
install_package_for_command findmnt util-linux || DEPENDENCY_FAILED=1
install_package_for_command lscpu util-linux || DEPENDENCY_FAILED=1
install_package_for_command ip iproute2 || DEPENDENCY_FAILED=1
install_package_for_command ethtool ethtool || DEPENDENCY_FAILED=1
install_package_for_command lspci pciutils || DEPENDENCY_FAILED=1
install_package_for_command lsusb usbutils || DEPENDENCY_FAILED=1
install_package_for_command iw iw || DEPENDENCY_FAILED=1
install_package_for_command iwconfig wireless-tools || DEPENDENCY_FAILED=1
install_package_for_command iperf3 iperf3 || DEPENDENCY_FAILED=1
install_package_for_command taskset util-linux || DEPENDENCY_FAILED=1
install_package_for_command gcc gcc || DEPENDENCY_FAILED=1
install_package_for_command make make || DEPENDENCY_FAILED=1
install_package_for_command git git || DEPENDENCY_FAILED=1

# Build mhz (real clockspeed measurement tool by Willy Tarreau)
MHZ_BIN="/tmp/imba-mhz/mhz"
if [[ ! -x "$MHZ_BIN" ]]; then
    if command_exists gcc && command_exists make && command_exists git; then
        if [[ "$SECTION_DEPENDENCY_PRINTED" -eq 0 ]]; then
            section "DEPENDENCY CHECK"
            SECTION_DEPENDENCY_PRINTED=1
        fi
        info "Building" "mhz (real clockspeed tool)..."
        rm -rf /tmp/imba-mhz 2>/dev/null
        git clone --depth 1 https://github.com/wtarreau/mhz /tmp/imba-mhz >/dev/null 2>&1
        if [[ -d /tmp/imba-mhz ]]; then
            make -C /tmp/imba-mhz >/dev/null 2>&1
            if [[ -x "$MHZ_BIN" ]]; then
                ok "mhz built successfully."
            else
                warn "Failed to compile mhz. Real clockspeed detection disabled."
            fi
        else
            warn "Failed to clone mhz repository. Real clockspeed detection disabled."
        fi
    fi
fi

# Build ampart (Amlogic partition tool by 7Ji)
if [[ "$SOC_NAME" == *"Amlogic"* || "${COMPAT:-}" == *"amlogic"* ]]; then
    if ! command_exists ampart; then
        if command_exists gcc && command_exists make && command_exists git; then
            if [[ "$SECTION_DEPENDENCY_PRINTED" -eq 0 ]]; then
                section "DEPENDENCY CHECK"
                SECTION_DEPENDENCY_PRINTED=1
            fi
            info "Building" "ampart (Amlogic partition tool)..."
            rm -rf /tmp/imba-ampart 2>/dev/null
            git clone --depth 1 https://github.com/7Ji/ampart /tmp/imba-ampart >/dev/null 2>&1
            if [[ -d /tmp/imba-ampart ]]; then
                make -C /tmp/imba-ampart >/dev/null 2>&1
                if [[ -x "/tmp/imba-ampart/ampart" ]]; then
                    mv /tmp/imba-ampart/ampart /usr/local/bin/ampart
                    chmod +x /usr/local/bin/ampart
                    ok "ampart built and installed."
                else
                    warn "Failed to compile ampart. Amlogic eMMC safe-write disabled."
                fi
            else
                warn "Failed to clone ampart repository. Amlogic eMMC safe-write disabled."
            fi
        fi
    fi
fi

if [[ "$RUN_SPEEDTEST" -eq 1 ]]; then
    IS_OOKLA=0
    if command_exists speedtest; then
        if speedtest --version 2>/dev/null | grep -qi "Ookla"; then IS_OOKLA=1; fi
    fi
    
    if [[ "$IS_OOKLA" -eq 0 ]]; then
        if [[ "$SECTION_DEPENDENCY_PRINTED" -eq 0 ]]; then
            section "DEPENDENCY CHECK"
            SECTION_DEPENDENCY_PRINTED=1
        fi
        
        info "Installing" "Ookla Speedtest..."
        ARCH=$(uname -m)
        case "$ARCH" in
            x86_64|amd64) OOKLA_ARCH="x86_64" ;;
            i*86) OOKLA_ARCH="i386" ;;
            aarch64|arm64) OOKLA_ARCH="aarch64" ;;
            armv7l|armv6l|armhf) OOKLA_ARCH="armhf" ;;
            *) OOKLA_ARCH="" ;;
        esac
        
        if [[ -n "$OOKLA_ARCH" ]]; then
            OOKLA_URL="https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-linux-${OOKLA_ARCH}.tgz"
            wget -qO- "$OOKLA_URL" | tar -xz -C /tmp 2>/dev/null
            if [[ -f "/tmp/speedtest" ]]; then
                mv /tmp/speedtest /usr/local/bin/speedtest
                chmod +x /usr/local/bin/speedtest
                rm -f /tmp/speedtest*
                ok "Ookla Speedtest installed."
            else
                warn "Failed to download Ookla Speedtest."
                install_package_for_command speedtest-cli speedtest-cli || DEPENDENCY_FAILED=1
            fi
        else
            warn "Architecture $ARCH not supported by Ookla binary."
            install_package_for_command speedtest-cli speedtest-cli || DEPENDENCY_FAILED=1
        fi
    fi
fi

if [[ "$DEPENDENCY_FAILED" -ne 0 ]]; then
    fail "One or more required dependencies could not be installed."
    if [[ "$SECTION_DEPENDENCY_PRINTED" -ne 0 ]]; then section_end; fi
    exit 1
fi

if [[ "$SECTION_DEPENDENCY_PRINTED" -ne 0 ]]; then
    section_end
fi

###############################################################################
# 0. PRE-FLIGHT SAFETY CHECKS
###############################################################################

section "PRE-FLIGHT CHECKS"
PREFLIGHT_WARN=0

if command_exists awk; then
    load_1m=$(awk '{print $1}' /proc/loadavg)
    load_int=${load_1m%%.*}
    if [[ "$load_int" -ge 2 ]]; then
        warn "High CPU load ($load_1m). Background tasks may affect results."
        PREFLIGHT_WARN=1
    else
        ok "CPU load is normal ($load_1m)."
    fi
fi

if command_exists vcgencmd; then
    throttled=$(vcgencmd get_throttled 2>/dev/null || echo "0x0")
    if [[ "$throttled" != "0x0" && "$throttled" != "throttled=0x0" ]]; then
        warn "Undervoltage or throttling detected ($throttled)."
        PREFLIGHT_WARN=1
    fi
fi

if [[ "$PREFLIGHT_WARN" -eq 0 ]]; then
    ok "All pre-flight safety checks passed."
fi
section_end

###############################################################################
# Deep Hardware Interrogation (EFUSE/NVMEM/SOCINFO)
###############################################################################
if [[ "$SOC_NAME" == *"Allwinner"* ]]; then
    AW_NVMEM_FILE="/sys/bus/nvmem/devices/sunxi-sid0/nvmem"
    if [[ -r "$AW_NVMEM_FILE" ]]; then
        if command_exists hexdump; then
            AW_NVMEM="$(hexdump -C < "$AW_NVMEM_FILE" 2>/dev/null | head -n1)"
            if [[ -n "$AW_NVMEM" ]]; then
                # Extract SID from hex bytes
                AW_SID="${AW_NVMEM:19:2}${AW_NVMEM:16:2}${AW_NVMEM:13:2}${AW_NVMEM:10:2}"
                [[ -n "$AW_SID" ]] && SOC_NAME="${SOC_NAME} (SID: ${AW_SID})"
            else
                SOC_NAME="${SOC_NAME} (SID: hexdump empty)"
            fi
        else
            SOC_NAME="${SOC_NAME} (SID: hexdump missing)"
        fi
    else
        SOC_NAME="${SOC_NAME} (SID: File Not Readable)"
    fi
elif [[ "$SOC_NAME" == *"Rockchip"* || "$COMPAT" == *"rockchip"* ]]; then
    RK_NVMEM_FILE="$(find /sys/bus/nvmem/devices/rockchip*/* -name nvmem 2>/dev/null | head -n1)"
    if [[ -e "$RK_NVMEM_FILE" ]]; then
        if command_exists hexdump; then
            RK_CHIP="$(hexdump -C < "$RK_NVMEM_FILE" 2>/dev/null | head -n1 | cut -d'|' -f2 | grep -oE '^(RK|RV)[0-9]+[A-Z0-9]*')"
            if [[ -n "$RK_CHIP" ]]; then
                SOC_NAME="Rockchip $RK_CHIP"
            else
                SOC_NAME="${SOC_NAME} (hexdump empty)"
            fi
        fi
    fi
elif [[ "$SOC_NAME" == *"Amlogic"* || "$COMPAT" == *"amlogic"* ]]; then
    if [[ -r /sys/devices/soc0/soc_id ]]; then
        AML_ID="$(cat /sys/devices/soc0/soc_id 2>/dev/null | tr -d '\0' | xargs)"
        AML_REV="$(cat /sys/devices/soc0/revision 2>/dev/null | tr -d '\0' | xargs)"
        if [[ -n "$AML_ID" ]]; then
            SOC_NAME="Amlogic $AML_ID"
            [[ -n "$AML_REV" ]] && SOC_NAME="${SOC_NAME} (Rev: $AML_REV)"
        fi
    fi
fi

init_power_monitor() {
    # Requires all three env vars to activate
    if [[ -z "$HA_URL" || -z "$HA_TOKEN" || -z "$HA_POWER_ENTITY" ]]; then
        POWER_MONITOR_ENABLED=0
        return
    fi

    # Validate connection and response
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" \
        --connect-timeout 5 --max-time 10 \
        -H "Authorization: Bearer $HA_TOKEN" \
        "${HA_URL}/api/states/${HA_POWER_ENTITY}" 2>/dev/null || echo "000")

    if [[ "$http_code" == "200" ]]; then
        local response unit device_class
        response=$(curl -s --connect-timeout 5 --max-time 10 \
            -H "Authorization: Bearer $HA_TOKEN" \
            "${HA_URL}/api/states/${HA_POWER_ENTITY}" 2>/dev/null)

        if command_exists jq; then
            unit=$(echo "$response" | jq -r '.attributes.unit_of_measurement // ""' 2>/dev/null)
            device_class=$(echo "$response" | jq -r '.attributes.device_class // ""' 2>/dev/null)
        else
            unit=$(echo "$response" | grep -o '"unit_of_measurement"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | grep -o '"[^"]*"$' | tr -d '"')
            device_class=$(echo "$response" | grep -o '"device_class"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | grep -o '"[^"]*"$' | tr -d '"')
        fi

        if [[ "$unit" == "W" && "$device_class" == "power" ]]; then
            POWER_MONITOR_ENABLED=1
            local friendly_name=""
            if command_exists jq; then
                friendly_name=$(echo "$response" | jq -r '.attributes.friendly_name // ""' 2>/dev/null)
                # Clean up common HA sensor suffixes for a cleaner display
                friendly_name="${friendly_name% Current consumption}"
                friendly_name="${friendly_name% current consumption}"
                friendly_name="${friendly_name% Power}"
                friendly_name="${friendly_name% power}"
            fi
            ok "Power Monitor : Enabled"
            info "Source" "Home Assistant"
            info "Entity" "$HA_POWER_ENTITY"
            if [[ -n "$friendly_name" ]]; then
                info "Device" "$friendly_name"
            fi
        else
            warn "Power entity unit/class mismatch (unit=${unit}, class=${device_class}). Power monitoring disabled."
            POWER_MONITOR_ENABLED=0
        fi
    elif [[ "$http_code" == "401" ]]; then
        warn "Home Assistant: Unauthorized (401). Check your IMBA_HA_TOKEN."
        POWER_MONITOR_ENABLED=0
    elif [[ "$http_code" == "404" ]]; then
        warn "Home Assistant: Entity not found (404). Check IMBA_HA_POWER_ENTITY."
        POWER_MONITOR_ENABLED=0
    else
        warn "Home Assistant: Connection failed (HTTP ${http_code}). Power monitoring disabled."
        POWER_MONITOR_ENABLED=0
    fi
}

read_power() {
    if [[ "$POWER_MONITOR_ENABLED" -ne 1 ]]; then
        echo ""
        return
    fi
    local response state
    response=$(curl -s --connect-timeout 3 --max-time 5 \
        -H "Authorization: Bearer $HA_TOKEN" \
        "${HA_URL}/api/states/${HA_POWER_ENTITY}" 2>/dev/null)

    if command_exists jq; then
        state=$(echo "$response" | jq -r '.state // ""' 2>/dev/null)
    else
        state=$(echo "$response" | grep -o '"state"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | grep -o '"[^"]*"$' | tr -d '"')
    fi

    # Validate numeric value
    if [[ "$state" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        echo "$state"
    else
        echo ""
    fi
}

###############################################################################
# AUTO MOUNT FLASH DRIVES
###############################################################################

ensure_fd_mounted() {
    for dev in /sys/block/*; do
        local bn="$(basename "$dev")"
        [[ "$bn" == mmcblk* || "$bn" == loop* || "$bn" == zram* || "$bn" == ram* || "$bn" == *boot* ]] && continue
        
        local mnt_point=""
        local target_part=""
        
        for part in /dev/${bn}*; do
            [[ -b "$part" ]] || continue
            mnt_point="$(findmnt -n -o TARGET "$part" 2>/dev/null | head -n1)"
            if [[ -n "$mnt_point" ]]; then
                target_part="$part"
                break
            fi
        done
        
        if [[ -z "$mnt_point" ]]; then
            target_part="$(lsblk -b -n -l -o NAME,TYPE,SIZE /dev/${bn} 2>/dev/null | awk '$2=="part" {print $3, $1}' | sort -n -r | head -n1 | awk '{print $2}')"
            [[ -n "$target_part" ]] && target_part="/dev/$target_part"
            [[ -z "$target_part" ]] && target_part="/dev/${bn}"
            
            if [[ -b "$target_part" ]]; then
                mnt_point="/mnt/imba_usb_${bn}"
                mkdir -p "$mnt_point"
                
                local fstype="$(blkid -s TYPE -o value "$target_part" 2>/dev/null)"
                local mounted=0
                
                if [[ "$fstype" == "ntfs" || "$fstype" == "exfat" ]]; then
                    if [[ "$fstype" == "ntfs" ]] && command_exists ntfsfix; then
                        ntfsfix -d "$target_part" >/dev/null 2>&1 || true
                    fi
                    if mount -t ntfs3 "$target_part" "$mnt_point" 2>/dev/null; then mounted=1; fi
                    if [[ "$mounted" -eq 0 ]] && mount -t ntfs-3g "$target_part" "$mnt_point" 2>/dev/null; then mounted=1; fi
                fi
                
                if [[ "$mounted" -eq 0 ]] && mount "$target_part" "$mnt_point" 2>/dev/null; then
                    mounted=1
                fi
                
                if [[ "$mounted" -eq 1 ]]; then
                    USB_MNT_POINTS="${USB_MNT_POINTS:-} $mnt_point"
                else
                    rmdir "$mnt_point" 2>/dev/null || true
                fi
            fi
        fi
    done
}

ensure_fd_mounted

