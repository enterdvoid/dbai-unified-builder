###############################################################################
# 2.5 THERMAL STRESS TEST
###############################################################################

if [[ "$RUN_STRESS" -eq 1 ]]; then
    section "THERMAL STRESS TEST"
    info "Duration" "15 Minutes"
    info "Workload" "sysbench cpu (all cores)"
    info "Status" "Running (Please wait...)"
    
    # Run sysbench in background for 900 seconds
    sysbench cpu --cpu-max-prime=20000 --threads="$(nproc)" --time=900 run > "$TEMP_ROOT/stress_raw.txt" 2>&1 &
    BENCH_PID=$!
    
    echo "  > Monitoring System (every 5s)..."
    if [[ "$POWER_MONITOR_ENABLED" -eq 1 ]]; then
        printf "  %-5s | %-6s | %-6s | %-6s | %s\n" "Time" "Temp" "RAM" "Power" "CPU Freq"
    else
        printf "  %-5s | %-6s | %-6s | %s\n" "Time" "Temp" "RAM" "CPU Freq"
    fi
    START_TIME=$(date +%s)
    
    while kill -0 $BENCH_PID 2>/dev/null; do
        NOW=$(date +%s)
        ELAPSED=$((NOW - START_TIME))
        M=$(printf "%02d" $((ELAPSED / 60)))
        S=$(printf "%02d" $((ELAPSED % 60)))
        
        TEMP_RAW="$(read_temperature "$TEMP_ZONE")"
        if [[ "$TEMP_RAW" != "N/A" ]]; then
            TEMP_VAL="${TEMP_RAW}C"
        else
            TEMP_VAL="N/A"
        fi
        
        RAM_USED="$(free -m | awk '/^Mem:/{print $3}')"
        RAM_VAL="${RAM_USED}MB"
        
        # Extract unique frequencies to save space (e.g. 1800,2400 MHz for big.LITTLE)
        FREQ_LIST=$(for ((i=0; i<$(nproc); i++)); do read_cpu_frequency "$i"; done | grep -v '^$' | sort -nu | tr '\n' ',' | sed 's/,$//')
        [[ -z "$FREQ_LIST" ]] && FREQ_LIST="N/A"
        FREQS="${FREQ_LIST} MHz"
        
        if [[ "$POWER_MONITOR_ENABLED" -eq 1 ]]; then
            PWR_RAW="$(read_power)"
            PWR_VAL="N/A"
            [[ -n "$PWR_RAW" && "$PWR_RAW" =~ ^[0-9] ]] && PWR_VAL="${PWR_RAW}W"
            printf "  %-5s | %-6s | %-6s | %-6s | %s\n" "${M}:${S}" "$TEMP_VAL" "$RAM_VAL" "$PWR_VAL" "$FREQS"
        else
            printf "  %-5s | %-6s | %-6s | %s\n" "${M}:${S}" "$TEMP_VAL" "$RAM_VAL" "$FREQS"
        fi
        
        sleep 5
    done
    
    wait $BENCH_PID
    ok "Stress Test Completed"
    
    echo
    echo "Raw sysbench output (Stress Test):"
    cat "$TEMP_ROOT/stress_raw.txt" 2>/dev/null || true
    section_end
fi

###############################################################################
# 3. MEMORY BENCHMARK
###############################################################################

if [[ "$RUN_MEM" -eq 1 ]]; then
section "MEMORY BENCHMARK"

if [[ "$RAM_AVAILABLE_MB" -lt 256 ]]; then
    MEMORY_BLOCK="512K"
elif [[ "$RAM_AVAILABLE_MB" -lt 512 ]]; then
    MEMORY_BLOCK="512K"
else
    MEMORY_BLOCK="1M"
fi

info "Memory Block" "$MEMORY_BLOCK"
info "Memory Workload Limit" "$MEMORY_TOTAL_SIZE (Total processed data limit over duration)"

if [[ "$RAM_AVAILABLE_MB" -lt 256 ]]; then
    warn "Very low available RAM detected."
    warn "Memory benchmark will use a small block size."
fi

start_cpu_monitor "memory"

subsection "Memory Read"
MEM_READ_OUT="$(sysbench memory \
    --threads="$(nproc)" \
    --memory-block-size="$MEMORY_BLOCK" \
    --memory-total-size="$MEMORY_TOTAL_SIZE" \
    --time="$MEMORY_DURATION" \
    --memory-oper=read \
    run)"
echo "$MEM_READ_OUT" > "$TEMP_ROOT/mem_read_raw.txt"
MEM_READ_SCORE="$(echo "$MEM_READ_OUT" | awk '/MiB transferred/ {print $4}' | tr -d '()')"
if [[ -n "$MEM_READ_SCORE" ]]; then
    info "Result" "$MEM_READ_SCORE MiB/s"
    echo "$MEM_READ_SCORE" > "$TEMP_ROOT/mem_read"
else
    info "Result" "FAILED"
fi

subsection "Memory Write"
MEM_WRITE_OUT="$(sysbench memory \
    --threads="$(nproc)" \
    --memory-block-size="$MEMORY_BLOCK" \
    --memory-total-size="$MEMORY_TOTAL_SIZE" \
    --time="$MEMORY_DURATION" \
    --memory-oper=write \
    run)"
echo "$MEM_WRITE_OUT" > "$TEMP_ROOT/mem_write_raw.txt"
MEM_WRITE_SCORE="$(echo "$MEM_WRITE_OUT" | awk '/MiB transferred/ {print $4}' | tr -d '()')"
if [[ -n "$MEM_WRITE_SCORE" ]]; then
    info "Result" "$MEM_WRITE_SCORE MiB/s"
    echo "$MEM_WRITE_SCORE" > "$TEMP_ROOT/mem_write"
else
    info "Result" "FAILED"
fi

stop_cpu_monitor
print_monitor_summary "$MONITOR_FILE"

section_end

echo
echo "Raw sysbench output (Memory Read):"
cat "$TEMP_ROOT/mem_read_raw.txt" 2>/dev/null || true
echo
echo "Raw sysbench output (Memory Write):"
cat "$TEMP_ROOT/mem_write_raw.txt" 2>/dev/null || true
print_cpu_monitor "$TEMP_ROOT/memory_monitor.txt"
fi

###############################################################################
# 4. STORAGE BENCHMARK
###############################################################################

if [[ "$RUN_STORAGE" -eq 1 ]]; then
section "STORAGE BENCHMARK"

ROOT_PARTITION="$(findmnt -n -o SOURCE / 2>/dev/null || echo unknown)"
ROOT_PARENT="$(lsblk -no PKNAME "$ROOT_PARTITION" 2>/dev/null || true)"
if [[ -n "$ROOT_PARENT" ]]; then
    ROOT_DEVICE="/dev/$ROOT_PARENT"
else
    ROOT_DEVICE="$ROOT_PARTITION"
fi

info "Root Partition" "$ROOT_PARTITION"
info "Root Device" "$ROOT_DEVICE"

subsection "MMC Configuration"
MMC_FOUND=0
for mmc in /sys/class/mmc_host/mmc*; do
    [[ -d "$mmc" ]] || continue
    MMC_FOUND=1
    for card in "$mmc"/mmc*; do
        [[ -d "$card" ]] || continue
        CARD_NAME="$(basename "$card")"
        subsection "MMC Card $CARD_NAME"
        [[ -r "$card/name" ]] && info "Name" "$(cat "$card/name")"
        [[ -r "$card/type" ]] && info "Type" "$(cat "$card/type")"
        [[ -r "$card/cid" ]] && info "CID" "$(cat "$card/cid")"
        [[ -r "$card/csd" ]] && info "CSD" "$(cat "$card/csd")"
        [[ -r "$card/date" ]] && info "Manufacture" "$(cat "$card/date")"
        [[ -r "$card/hwrev" ]] && info "HW Revision" "$(cat "$card/hwrev")"
    done
done
if [[ "$MMC_FOUND" -eq 0 ]]; then
    info "MMC" "No MMC information available"
fi

get_free_space_mb() {
    local path="$1"
    df -Pm "$path" 2>/dev/null | awk 'NR==2 {print $4}'
}

subsection "Dynamic Storage Benchmark"

warn "Sequential Read tests are performed on all detected block devices."
warn "Random Read tests (QD1/QD32) are performed on all detected block devices."
warn "Random Write tests are performed ONLY on the Root Partition (File I/O) and verified Android Userdata partitions."

start_cpu_monitor "storage"

STORAGE_DEVICES=()
for dev in /sys/block/*; do
    bn="$(basename "$dev")"
    [[ "$bn" == loop* || "$bn" == zram* || "$bn" == ram* || "$bn" == *boot* ]] && continue

    STORAGE_DEVICES+=("$bn")
done

for bn in "${STORAGE_DEVICES[@]}"; do
    device="/dev/$bn"
    [[ -b "$device" ]] || continue
    
    subsection "Device: $device"
    
    dev_type="Drive"
    if [[ "$bn" == mmcblk* ]]; then
        type_file="/sys/block/$bn/device/type"
        if [[ -f "$type_file" ]]; then
            t="$(cat "$type_file")"
            [[ "$t" == "MMC" ]] && dev_type="eMMC" || dev_type="SD Card"
        else
            dev_type="SD/eMMC"
        fi
    elif [[ "$bn" == nvme* ]]; then
        dev_type="NVMe SSD"
    elif [[ "$bn" == sd* ]]; then
        tran="$(lsblk -ndo TRAN "$device" 2>/dev/null || true)"
        rota="$(lsblk -ndo ROTA "$device" 2>/dev/null || true)"
        if [[ "$tran" == "usb" ]]; then
            dev_type="USB Drive"
        elif [[ "$tran" == "sata" ]]; then
            [[ "$rota" == "1" ]] && dev_type="SATA HDD" || dev_type="SATA SSD"
        fi
    fi
    
    size="$(lsblk -ndo SIZE "$device" 2>/dev/null || echo unknown)"
    model="$(lsblk -ndo MODEL "$device" 2>/dev/null | xargs 2>/dev/null || echo unknown)"
    if [[ "$model" == "unknown" || -z "$model" ]]; then
        model="$(cat /sys/block/$bn/device/name 2>/dev/null || echo unknown)"
    fi
    
    info "Type" "$dev_type"
    info "Model" "$model"
    info "Size" "$size"
    
    # --- SEQUENTIAL READ ---
    info "Status" "Running Sequential Read..."
    FIO_SEQ_OUT="$(fio \
        --name="${bn}_seqread" \
        --filename="$device" \
        --direct=1 \
        --rw=read \
        --bs="$FIO_BS" \
        --size="$FIO_SIZE" \
        --iodepth=1 \
        --ioengine=libaio \
        --runtime=0 \
        --time_based=0 \
        --group_reporting 2>/dev/null || true)"
    echo "$FIO_SEQ_OUT" > "$TEMP_ROOT/${bn}_seq_raw.txt"
    FIO_SEQ_VAL="$(echo "$FIO_SEQ_OUT" | awk '/read: IOPS=/ {
        iops=$2; gsub(/IOPS=|,/, "", iops);
        bw=$3; gsub(/BW=/, "", bw);
        print iops " IOPS (" bw ")"
    }')"
    if [[ -n "$FIO_SEQ_VAL" ]]; then
        info "Seq Read" "$FIO_SEQ_VAL"
    else
        FIO_SEQ_VAL="SKIPPED"
        info "Seq Read" "FAILED/SKIPPED"
    fi

    # --- RANDOM 4K QD1 READ ---
    info "Status" "Running Random 4K QD1 Read..."
    FIO_QD1_OUT="$(fio \
        --name="${bn}_randread_qd1" \
        --filename="$device" \
        --direct=1 \
        --rw=randread \
        --bs=4k \
        --size="$FIO_SIZE" \
        --iodepth=1 \
        --ioengine=libaio \
        --runtime=60 \
        --time_based=1 \
        --group_reporting 2>/dev/null || true)"
    echo "$FIO_QD1_OUT" > "$TEMP_ROOT/${bn}_qd1_raw.txt"
    FIO_QD1_VAL="$(echo "$FIO_QD1_OUT" | awk '/read: IOPS=/ {
        iops=$2; gsub(/IOPS=|,/, "", iops);
        bw=$3; gsub(/BW=/, "", bw);
        print iops " IOPS (" bw ")"
    }')"
    if [[ -n "$FIO_QD1_VAL" ]]; then
        info "Rand 4K QD1" "$FIO_QD1_VAL"
    else
        FIO_QD1_VAL="SKIPPED"
        info "Rand 4K QD1" "FAILED/SKIPPED"
    fi

    # --- RANDOM 4K QD32 READ ---
    info "Status" "Running Random 4K QD32 Read..."
    FIO_QD32_OUT="$(fio \
        --name="${bn}_randread_qd32" \
        --filename="$device" \
        --direct=1 \
        --rw=randread \
        --bs=4k \
        --size="$FIO_SIZE" \
        --iodepth=32 \
        --ioengine=libaio \
        --runtime=60 \
        --time_based=1 \
        --group_reporting 2>/dev/null || true)"
    echo "$FIO_QD32_OUT" > "$TEMP_ROOT/${bn}_qd32_raw.txt"
    FIO_QD32_VAL="$(echo "$FIO_QD32_OUT" | awk '/read: IOPS=/ {
        iops=$2; gsub(/IOPS=|,/, "", iops);
        bw=$3; gsub(/BW=/, "", bw);
        print iops " IOPS (" bw ")"
    }')"
    if [[ -n "$FIO_QD32_VAL" ]]; then
        info "Rand 4K QD32" "$FIO_QD32_VAL"
    else
        FIO_QD32_VAL="SKIPPED"
        info "Rand 4K QD32" "FAILED/SKIPPED"
    fi
    
    # --- WRITE BENCHMARK ---
    FIO_WRITE_VAL="SKIPPED"
    
    if [[ "$device" == "$ROOT_DEVICE" ]]; then
        info "Status" "Root device detected. Running sysbench fileio write on \$TEMP_ROOT..."
        if ! cd "$TEMP_ROOT" 2>/dev/null; then
            info "File I/O Random" "SKIPPED (Read-only or permission denied)"
        else
            sysbench fileio --file-total-size=1G prepare > /dev/null 2>&1
            FILEIO_OUT="$(sysbench fileio --file-total-size=1G --file-test-mode=rndwr --time=30 --max-requests=0 run 2>&1 || true)"
            sysbench fileio --file-total-size=1G cleanup > /dev/null 2>&1
            cd - > /dev/null || true
            
            echo "$FILEIO_OUT" > "$TEMP_ROOT/${bn}_write_raw.txt"
            wr_iops="$(echo "$FILEIO_OUT" | awk '/writes\/s:/ {print $2}')"
            wr_bw="$(echo "$FILEIO_OUT" | awk '/written, MiB\/s:/ {print $3}')"
            
            if [[ -n "$wr_iops" && -n "$wr_bw" ]]; then
                FIO_WRITE_VAL="${wr_iops} IOPS (${wr_bw}MiB/s)"
                info "File I/O Random" "$FIO_WRITE_VAL"
            else
                info "File I/O Random" "FAILED"
            fi
        fi
        
    elif [[ "$dev_type" == "eMMC" ]]; then
        andr_part=""
        loop_device_created=""
        if command_exists blkid; then
            andr_part="$(blkid -t PARTLABEL=userdata -o device 2>/dev/null | grep "$bn" | head -n1)"
            [[ -z "$andr_part" ]] && andr_part="$(blkid -t PARTLABEL=data -o device 2>/dev/null | grep "$bn" | head -n1)"
            [[ -z "$andr_part" ]] && andr_part="$(blkid -t PARTLABEL=UDISK -o device 2>/dev/null | grep "$bn" | head -n1)"
        fi
        
        if [[ -z "$andr_part" ]] && command_exists ampart && command_exists losetup; then
            info "Status" "Using ampart to probe Amlogic eMMC partitions..."
            ampart_out="$(ampart "$device" 2>&1 || true)"
            if [[ -n "$ampart_out" ]]; then
                data_line="$(echo "$ampart_out" | grep -iE '^[[:space:]]*[0-9]+:[[:space:]]+(data|userdata)[[:space:]]+' | tail -n1)"
                if [[ -n "$data_line" ]]; then
                    data_clean="$(echo "$data_line" | sed 's/([^)]*)//g')"
                    offset_hex="$(echo "$data_clean" | awk '{print $3}')"
                    size_hex="$(echo "$data_clean" | awk '{print $4}')"
                    if [[ -n "$offset_hex" && -n "$size_hex" ]]; then
                        offset_hex="0x${offset_hex#0x}"
                        size_hex="0x${size_hex#0x}"
                        offset_dec=$(( offset_hex ))
                        size_dec=$(( size_hex ))
                        if [[ "$offset_dec" -gt 0 && "$size_dec" -gt 0 ]]; then
                            info "Status" "Mapping userdata via loopback (${offset_hex})..."
                            andr_part="$(losetup -f --show --offset "$offset_dec" --sizelimit "$size_dec" "$device" 2>/dev/null)"
                            loop_device_created="$andr_part"
                        fi
                    fi
                fi
            fi
        fi
        
        if [[ -n "$andr_part" ]]; then
            info "Status" "Android userdata partition ($andr_part) detected. Safe Write testing..."
            ANDROID_MNT="/mnt/imba_android_$bn"
            mkdir -p "$ANDROID_MNT"
            if mount -o ro "$andr_part" "$ANDROID_MNT" 2>/dev/null; then
                if [[ -d "$ANDROID_MNT/app" && -d "$ANDROID_MNT/dalvik-cache" ]]; then
                    mount -o remount,rw "$ANDROID_MNT" 2>/dev/null
                    FREE_MB=$(df -m "$ANDROID_MNT" | awk 'NR==2 {print $4}')
                    if [[ -n "$FREE_MB" && "$FREE_MB" -gt 500 ]]; then
                        TEST_SIZE=$(( FREE_MB / 2 ))
                        [[ "$TEST_SIZE" -gt 1024 ]] && TEST_SIZE=1024
                        
                        BENCH_DIR="$ANDROID_MNT/imba_test"
                        if ! mkdir -p "$BENCH_DIR" 2>/dev/null || ! cd "$BENCH_DIR" 2>/dev/null; then
                            info "File I/O Random" "SKIPPED (Read-only filesystem)"
                            umount "$ANDROID_MNT" 2>/dev/null || true
                            rmdir "$ANDROID_MNT" 2>/dev/null || true
                            continue
                        fi
                        
                        sysbench fileio --file-total-size=${TEST_SIZE}M prepare > /dev/null 2>&1
                        ANDROID_WR_OUT="$(sysbench fileio --file-total-size=${TEST_SIZE}M --file-test-mode=rndwr --time=30 --max-requests=0 run 2>&1 || true)"
                        sysbench fileio --file-total-size=${TEST_SIZE}M cleanup > /dev/null 2>&1
                        cd - > /dev/null || true
                        
                        echo "$ANDROID_WR_OUT" > "$TEMP_ROOT/${bn}_write_raw.txt"
                        wr_iops="$(echo "$ANDROID_WR_OUT" | awk '/writes\/s:/ {print $2}')"
                        wr_bw="$(echo "$ANDROID_WR_OUT" | awk '/written, MiB\/s:/ {print $3}')"
                        
                        if [[ -n "$wr_iops" && -n "$wr_bw" ]]; then
                            FIO_WRITE_VAL="${wr_iops} IOPS (${wr_bw}MiB/s)"
                            info "File I/O Random" "$FIO_WRITE_VAL"
                        else
                            info "File I/O Random" "FAILED"
                        fi
                    else
                        info "File I/O Random" "SKIPPED (Available space < 500MB)"
                    fi
                else
                    info "File I/O Random" "SKIPPED (Fingerprint mismatch)"
                fi
                umount "$ANDROID_MNT" 2>/dev/null || true
                rmdir "$ANDROID_MNT" 2>/dev/null || true
            else
                info "File I/O Random" "SKIPPED (Mount failed)"
            fi
        else
            info "File I/O Random" "SKIPPED (No userdata partition found)"
        fi
        
        if [[ -n "$loop_device_created" ]]; then
            losetup -d "$loop_device_created" 2>/dev/null || true
        fi
    else
        target_part=""
        mnt_point=""
        
        # Look for an already mounted partition (should be mounted by ensure_fd_mounted globally)
        for part in /dev/${bn}*; do
            [[ -b "$part" ]] || continue
            mnt_point="$(findmnt -n -o TARGET "$part" 2>/dev/null | head -n1)"
            if [[ -n "$mnt_point" ]]; then
                target_part="$part"
                break
            fi
        done
        
        if [[ -n "$mnt_point" ]]; then
            info "Status" "Found mounted $target_part at $mnt_point. Running safe write test..."
            FREE_MB=$(df -m "$mnt_point" | awk 'NR==2 {print $4}')
            if [[ -n "$FREE_MB" && "$FREE_MB" -gt 500 ]]; then
                TEST_SIZE=$(( FREE_MB / 2 ))
                [[ "$TEST_SIZE" -gt 1024 ]] && TEST_SIZE=1024
                
                BENCH_DIR="$mnt_point/imba_test_$$"
                if ! mkdir -p "$BENCH_DIR" 2>/dev/null || ! cd "$BENCH_DIR" 2>/dev/null; then
                    info "File I/O Random" "SKIPPED (Read-only filesystem)"
                else
                    sysbench fileio --file-total-size=${TEST_SIZE}M prepare > /dev/null 2>&1
                    USB_WR_OUT="$(sysbench fileio --file-total-size=${TEST_SIZE}M --file-test-mode=rndwr --time=30 --max-requests=0 run 2>&1 || true)"
                    sysbench fileio --file-total-size=${TEST_SIZE}M cleanup > /dev/null 2>&1
                    cd - > /dev/null || true
                    rmdir "$BENCH_DIR" 2>/dev/null || true
                    
                    echo "$USB_WR_OUT" > "$TEMP_ROOT/${bn}_write_raw.txt"
                    wr_iops="$(echo "$USB_WR_OUT" | awk '/writes\/s:/ {print $2}')"
                    wr_bw="$(echo "$USB_WR_OUT" | awk '/written, MiB\/s:/ {print $3}')"
                    
                    if [[ -n "$wr_iops" && -n "$wr_bw" ]]; then
                        FIO_WRITE_VAL="${wr_iops} IOPS (${wr_bw}MiB/s)"
                        info "File I/O Random" "$FIO_WRITE_VAL"
                    else
                        info "File I/O Random" "FAILED"
                    fi
                fi
            else
                info "File I/O Random" "SKIPPED (Available space < 500MB)"
            fi
            

        else
            info "File I/O Random" "SKIPPED (Could not mount $dev_type)"
        fi
    fi
    
    echo "${dev_type}|${model}|${size}|${FIO_SEQ_VAL}|${FIO_QD1_VAL}|${FIO_QD32_VAL}|${FIO_WRITE_VAL}" > "$TEMP_ROOT/storage_result_${bn}"
done

stop_cpu_monitor
print_monitor_summary "$MONITOR_FILE"

section_end

echo
echo "Storage Topology (lsblk):"
lsblk --ascii -o NAME,MODEL,SIZE,TYPE,FSTYPE,TRAN,ROTA,MOUNTPOINTS 2>/dev/null || lsblk -o NAME,MODEL,SIZE,TYPE,FSTYPE,TRAN,ROTA,MOUNTPOINTS
echo

for raw in "$TEMP_ROOT"/*_seq_raw.txt; do
    [[ -f "$raw" ]] || continue
    bn="$(basename "$raw" "_seq_raw.txt")"
    echo "Raw fio output (Sequential Read $bn):"
    cat "$raw" 2>/dev/null || true
    echo
done
for raw in "$TEMP_ROOT"/*_qd1_raw.txt; do
    [[ -f "$raw" ]] || continue
    bn="$(basename "$raw" "_qd1_raw.txt")"
    echo "Raw fio output (Random 4K QD1 Read $bn):"
    cat "$raw" 2>/dev/null || true
    echo
done
for raw in "$TEMP_ROOT"/*_qd32_raw.txt; do
    [[ -f "$raw" ]] || continue
    bn="$(basename "$raw" "_qd32_raw.txt")"
    echo "Raw fio output (Random 4K QD32 Read $bn):"
    cat "$raw" 2>/dev/null || true
    echo
done
for raw in "$TEMP_ROOT"/*_write_raw.txt; do
    [[ -f "$raw" ]] || continue
    bn="$(basename "$raw" "_write_raw.txt")"
    echo "Raw sysbench output (Write $bn):"
    cat "$raw" 2>/dev/null || true
    echo
done
print_cpu_monitor "$TEMP_ROOT/storage_monitor.txt"
fi

###############################################################################
# 5. NETWORK
###############################################################################

if [[ "$RUN_NET" -eq 1 ]]; then
section "NETWORK"

start_cpu_monitor "network"

subsection "Network Interfaces"
NETWORK_FOUND=0
for iface_path in /sys/class/net/*; do
    iface="$(basename "$iface_path")"
    [[ "$iface" == "lo" ]] && continue
    # Skip virtual/container interfaces
    [[ -d "/sys/devices/virtual/net/$iface" ]] && continue
    NETWORK_FOUND=1
    subsection "Interface $iface"
    
    # 1. Gather Type, Wi-Fi Band & Standard
    if [[ -d "/sys/class/net/$iface/wireless" || -d "/sys/class/net/$iface/phy80211" ]]; then
        info "Type" "Wi-Fi (Wireless LAN)"
        if command_exists iwconfig; then
            wifi_std="$(iwconfig "$iface" 2>/dev/null | grep -io 'IEEE 802.11[a-z]*')"
            [[ -n "$wifi_std" ]] && info "Standard" "$wifi_std"
        fi
        if command_exists iw; then
            wifi_link="$(iw dev "$iface" link 2>/dev/null)"
            if [[ "$wifi_link" == *"Connected to"* || "$wifi_link" == *"SSID:"* ]]; then
                wifi_ssid="$(echo "$wifi_link" | awk -F 'SSID: ' '/SSID:/ {print $2}')"
                wifi_freq="$(echo "$wifi_link" | awk '/freq:/ {print $2}')"
                wifi_sig="$(echo "$wifi_link" | awk '/signal:/ {print $2 " " $3}')"
                wifi_tx="$(echo "$wifi_link" | grep -i 'tx bitrate:' | awk '{print $3 " " $4}')"
                wifi_rx="$(echo "$wifi_link" | grep -i 'rx bitrate:' | awk '{print $3 " " $4}')"

                [[ -n "$wifi_ssid" ]] && info "SSID" "$wifi_ssid"

                if [[ -n "$wifi_freq" ]]; then
                    band="Unknown"
                    chan="?"
                    if [[ "$wifi_freq" -ge 2412 && "$wifi_freq" -le 2472 ]]; then 
                        band="2.4 GHz"; chan=$(((wifi_freq - 2407) / 5))
                    elif [[ "$wifi_freq" -eq 2484 ]]; then
                        band="2.4 GHz"; chan=14
                    elif [[ "$wifi_freq" -ge 5000 && "$wifi_freq" -le 5900 ]]; then 
                        band="5 GHz"; chan=$(((wifi_freq - 5000) / 5))
                    elif [[ "$wifi_freq" -ge 5900 && "$wifi_freq" -le 7200 ]]; then 
                        band="6 GHz"
                    fi
                    
                    if [[ "$chan" != "?" ]]; then
                        info "Wi-Fi Band" "$band (Ch $chan, $wifi_freq MHz)"
                    else
                        info "Wi-Fi Band" "$band ($wifi_freq MHz)"
                    fi
                fi
                
                [[ -n "$wifi_sig" ]] && info "Signal" "$wifi_sig"
                [[ -n "$wifi_tx" ]] && info "Tx Speed" "$wifi_tx"
                [[ -n "$wifi_rx" ]] && info "Rx Speed" "$wifi_rx"
            else
                info "Wi-Fi Status" "Not connected"
            fi
        fi
    else
        # If not wireless, usually Ethernet
        info "Type" "Ethernet (Wired LAN)"
    fi

    # 2. Gather Chipset / Hardware Info
    if [[ -L "/sys/class/net/$iface/device" ]]; then
        dev_path="$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)"
        chip_info=""
        if [[ "$dev_path" == *"/pci"* ]] && command_exists lspci; then
            pci_id="$(basename "$dev_path")"
            chip_info="$(lspci -s "$pci_id" 2>/dev/null | cut -d':' -f3- | sed 's/^[ \t]*//')"
            [[ -n "$chip_info" ]] && info "Chipset" "$chip_info"
        elif [[ "$dev_path" == *"/usb"* ]] && command_exists lsusb; then
            vid="$(cat "$dev_path/idVendor" 2>/dev/null || true)"
            pid="$(cat "$dev_path/idProduct" 2>/dev/null || true)"
            if [[ -n "$vid" && -n "$pid" ]]; then
                chip_info="$(lsusb -d "${vid}:${pid}" 2>/dev/null | head -n1 | cut -d':' -f3- | sed 's/^[ \t]*//')"
                [[ -n "$chip_info" ]] && info "Chipset" "$chip_info"
            fi
        fi
        
        # SDIO detection (e.g. Broadcom/Realtek SDIO)
        if [[ -z "$chip_info" && -f "$dev_path/vendor" && -f "$dev_path/device" ]]; then
            ven="$(cat "$dev_path/vendor" 2>/dev/null || true)"
            dev="$(cat "$dev_path/device" 2>/dev/null || true)"
            if [[ -n "$ven" && -n "$dev" && "$ven" != "0x0000" ]]; then
                info "SDIO ID" "${ven}:${dev}"
                # Broadcom SDIO Dictionary for brcmfmac
                if [[ "${ven,,}" == "0x02d0" || "${ven,,}" == "0x0489" ]]; then
                    case "${dev,,}" in
                        "0xa9a6") chip_info="Broadcom BCM43455 (Wi-Fi 5 SDIO)" ;;
                        "0xa9a4") chip_info="Broadcom BCM43430 (Wi-Fi 4 SDIO)" ;;
                        "0x4330") chip_info="Broadcom BCM4330 (Wi-Fi 4 SDIO)" ;;
                        "0x4343") chip_info="Broadcom BCM43438 (Wi-Fi 4 SDIO)" ;;
                        "0x4345") chip_info="Broadcom BCM4345 (Wi-Fi 5 SDIO)" ;;
                        "0x4354") chip_info="Broadcom BCM4354 (Wi-Fi 5 SDIO)" ;;
                        "0x4356") chip_info="Broadcom BCM4356 (Wi-Fi 5 SDIO)" ;;
                        "0x4359"|"0xa816"|"0xa822") chip_info="Broadcom BCM4359 (Wi-Fi 5 SDIO)" ;;
                        "0x4373") chip_info="Broadcom BCM4373 (Wi-Fi 5 SDIO)" ;;
                        "0x4375") chip_info="Broadcom BCM4375 (Wi-Fi 6 SDIO)" ;;
                    esac
                    [[ -n "$chip_info" ]] && info "Chipset" "$chip_info"
                fi
            fi
        fi
        
        driver_name="$(basename "$(readlink -f "$dev_path/driver" 2>/dev/null)" 2>/dev/null || true)"
        
        # Embedded SBC Wi-Fi Heuristic (SDIO chips lack a public lssdio database)
        if [[ -z "$chip_info" && -n "$driver_name" ]]; then
            case "$driver_name" in
                "unisoc_wifi"|"uwe5622") chip_info="Unisoc UWE5622 (SDIO)" ;;
                "uwe5621") chip_info="Unisoc UWE5621 (SDIO)" ;;
                "rtw88_8822cs"|"8822cs") chip_info="Realtek RTL8822CS (Wi-Fi 5 SDIO)" ;;
                "rtw88_8822bs"|"8822bs") chip_info="Realtek RTL8822BS (Wi-Fi 5 SDIO)" ;;
                "rtw88_8723cs"|"8723cs") chip_info="Realtek RTL8723CS (Wi-Fi 4 SDIO)" ;;
                "rtw89_8852bs"|"8852bs") chip_info="Realtek RTL8852BS (Wi-Fi 6 SDIO)" ;;
                "rtw89_8852cs"|"8852cs") chip_info="Realtek RTL8852CS (Wi-Fi 6 SDIO)" ;;
                "rtl8189fs"|"8189fs") chip_info="Realtek RTL8189FS (Wi-Fi 4 SDIO)" ;;
                "rtl8189es"|"8189es") chip_info="Realtek RTL8189ES (Wi-Fi 4 SDIO)" ;;
                "rtl8821cs"|"8821cs") chip_info="Realtek RTL8821CS (Wi-Fi 5 SDIO)" ;;
                "brcmfmac") chip_info="Broadcom / Cypress AP62xx (SDIO)" ;;
                "dhd"|"bcmdhd") chip_info="Broadcom / Ampak BCM (SDIO)" ;;
                "xradio_wlan") chip_info="Allwinner XR819 (SDIO)" ;;
                "mwifiex_sdio") chip_info="Marvell / NXP Wi-Fi (SDIO)" ;;
                "wl18xx") chip_info="Texas Instruments WL18xx (SDIO)" ;;
                "aic8800") chip_info="AIC Semi AIC8800 (Wi-Fi 6 SDIO/USB)" ;;
                "mt7668"|"mt7668sn") chip_info="MediaTek MT7668 (Wi-Fi 5 SDIO)" ;;
                "mt7601u") chip_info="MediaTek MT7601U (Wi-Fi 4 USB)" ;;
                "ssv6051") chip_info="SSV6051 (Wi-Fi 4 SDIO)" ;;
                "qca9377") chip_info="Qualcomm QCA9377 (Wi-Fi 5 SDIO)" ;;
                "wcn36xx"|"wcn3990") chip_info="Qualcomm WCN (SDIO)" ;;
            esac
            [[ -n "$chip_info" ]] && info "Chipset" "$chip_info"
        fi

        # Platform device detection (e.g. Allwinner internal Ethernet MAC)
        if [[ -z "$chip_info" && -f "$dev_path/of_node/compatible" ]]; then
            # compatible strings are null-terminated, grab the first one
            compat="$(tr '\0' '\n' < "$dev_path/of_node/compatible" | head -n 1 2>/dev/null)"
            [[ -n "$compat" ]] && info "MAC (SoC)" "$compat"
        fi
        
        [[ -n "$driver_name" ]] && info "Driver" "$driver_name"
    fi

    # 3. Gather Ethernet PHY Chip Info (if external PHY exists)
    if [[ -L "/sys/class/net/$iface/phydev" ]]; then
        phy_drv="$(basename "$(readlink -f "/sys/class/net/$iface/phydev/driver" 2>/dev/null)" 2>/dev/null || true)"
        phy_id="$(cat "/sys/class/net/$iface/phydev/phy_id" 2>/dev/null || true)"
        if [[ -n "$phy_drv" ]]; then
            # Sometimes driver name is very descriptive like "Motorola Ethernet PHY"
            info "PHY Chip" "$phy_drv"
        fi
        if [[ -n "$phy_id" ]]; then
            info "PHY ID" "$phy_id"
        fi
    fi

    state="$(cat "$iface_path/operstate" 2>/dev/null || echo unknown)"
    info "State" "$state"
    if command_exists ethtool; then
        SPEED="$(ethtool "$iface" 2>/dev/null | awk -F': ' '/Speed:/ {print $2; exit}')"
        DUPLEX="$(ethtool "$iface" 2>/dev/null | awk -F': ' '/Duplex:/ {print $2; exit}')"
        LINK="$(ethtool "$iface" 2>/dev/null | awk -F': ' '/Link detected:/ {print $2; exit}')"
        [[ -n "$SPEED" && "$SPEED" != "Unknown!" ]] && info "Speed" "$SPEED"
        [[ -n "$DUPLEX" && "$DUPLEX" != "Unknown!" ]] && info "Duplex" "$DUPLEX"
        [[ -n "$LINK" ]] && info "Link" "$LINK"
    fi
    if command_exists ip; then
        ip_addr="$(ip -brief addr show "$iface" 2>/dev/null | awk '{print $3}')"
        [[ -n "$ip_addr" ]] && info "IP Address" "$ip_addr"
    fi
done
if [[ "$NETWORK_FOUND" -eq 0 ]]; then
    info "Network" "No interface detected"
fi

subsection "Local Loopback (Internal iperf3)"
if command_exists iperf3; then
    iperf3 --server --daemon --one-off 2>/dev/null
    sleep 1

    IPERF_LOCAL_OUT="$(iperf3 --client 127.0.0.1 --time 10 --format m 2>&1 || true)"
    echo "$IPERF_LOCAL_OUT" > "$TEMP_ROOT/iperf_local_raw.txt"

    IPERF_LOCAL_VAL="$(echo "$IPERF_LOCAL_OUT" | awk '/receiver/ {print $(NF-2) " " $(NF-1)}')"
    if [[ -n "$IPERF_LOCAL_VAL" ]]; then
        info "Loopback TCP" "$IPERF_LOCAL_VAL"
        echo "$IPERF_LOCAL_VAL" > "$TEMP_ROOT/net_local"
    else
        fail "Local loopback test failed."
    fi
else
    skip "iperf3 command unavailable."
fi

subsection "Local Network Benchmark (iperf3)"
if [[ -z "$IPERF_SERVER" ]]; then
    skip "iperf3 benchmark: no server configured."
    info "Usage" "IMBA_IPERF_SERVER=192.168.1.10 ./imba.sh"
elif ! command_exists iperf3; then
    skip "iperf3 command unavailable."
else
    info "iperf3 Server" "$IPERF_SERVER"

    DEFAULT_IFACE=$(ip -4 route show default 2>/dev/null | awk '{print $5}' | head -n1)
    [[ -z "$DEFAULT_IFACE" ]] && DEFAULT_IFACE="unknown"
    echo "$DEFAULT_IFACE" > "$TEMP_ROOT/net_iface"

    subsection "Active Interface Download ($DEFAULT_IFACE)"
    IPERF_DL_OUT="$(iperf3 \
        --client "$IPERF_SERVER" \
        --time 30 \
        --format m \
        --reverse 2>&1 || true)"
    echo "$IPERF_DL_OUT" > "$TEMP_ROOT/iperf_dl_raw.txt"

    IPERF_DL_VAL="$(echo "$IPERF_DL_OUT" | awk '/receiver/ {print $(NF-2) " " $(NF-1)}')"
    if [[ -n "$IPERF_DL_VAL" ]]; then
        info "Result" "$IPERF_DL_VAL"
        echo "$IPERF_DL_VAL" > "$TEMP_ROOT/net_down"
    else
        info "Result" "FAILED"
    fi

    subsection "Active Interface Upload ($DEFAULT_IFACE)"
    IPERF_UL_OUT="$(iperf3 \
        --client "$IPERF_SERVER" \
        --time 30 \
        --format m 2>&1 || true)"
    echo "$IPERF_UL_OUT" > "$TEMP_ROOT/iperf_ul_raw.txt"

    IPERF_UL_VAL="$(echo "$IPERF_UL_OUT" | awk '/receiver/ {print $(NF-2) " " $(NF-1)}')"
    if [[ -n "$IPERF_UL_VAL" ]]; then
        info "Result" "$IPERF_UL_VAL"
        echo "$IPERF_UL_VAL" > "$TEMP_ROOT/net_up"
    else
        info "Result" "FAILED"
    fi

    if command_exists nmcli; then
        subsection "WiFi Auto-Cycle (Local iperf3)"
        saved_wifis=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2=="802-11-wireless" {print $1}')
        if [[ -z "$saved_wifis" ]]; then
            info "WiFi Auto-Cycle" "No saved WiFi profiles found."
        else
            available_wifi_data=$(nmcli -t -f SSID,FREQ,SIGNAL dev wifi 2>/dev/null)
            in_range_wifis=""
            for wifi in $saved_wifis; do
                if echo "$available_wifi_data" | awk -F: -v w="$wifi" '$1==w' | grep -q .; then
                    in_range_wifis="${in_range_wifis}${wifi} "
                fi
            done
            
            count=$(echo "$in_range_wifis" | wc -w)
            target_wifis=""
            
            if [[ $count -le 1 ]]; then
                target_wifis="$in_range_wifis"
            else
                best_24=""
                best_24_sig=0
                best_50=""
                best_50_sig=0
                
                for wifi in $in_range_wifis; do
                    IFS=: read -r w_ssid w_freq w_sig <<< $(echo "$available_wifi_data" | awk -F: -v w="$wifi" '$1==w' | sort -t: -k3 -nr | head -n1)
                    w_freq_num=$(echo "$w_freq" | tr -dc '0-9')
                    if [[ -n "$w_freq_num" ]]; then
                        if [[ $w_freq_num -lt 3000 ]]; then
                            if [[ $w_sig -gt $best_24_sig ]]; then
                                best_24_sig=$w_sig
                                best_24="$wifi"
                            fi
                        else
                            if [[ $w_sig -gt $best_50_sig ]]; then
                                best_50_sig=$w_sig
                                best_50="$wifi"
                            fi
                        fi
                    fi
                done
                target_wifis="$best_24 $best_50"
            fi

            for wifi in $target_wifis; do
                [[ -z "$wifi" ]] && continue
                was_active=0
                if nmcli -t -f NAME,STATE connection show --active 2>/dev/null | grep -Fqx "${wifi}:activated"; then
                    was_active=1
                fi
                
                if [[ "$was_active" -eq 0 ]]; then
                    info "Connecting" "$wifi"
                    nmcli connection up "$wifi" >/dev/null 2>&1
                    CONN_STATUS=$?
                    sleep 3
                else
                    info "Using active WiFi" "$wifi"
                    CONN_STATUS=0
                fi

                if [[ $CONN_STATUS -eq 0 ]]; then
                    wifi_iface=$(nmcli -t -f DEVICE,CONNECTION dev 2>/dev/null | awk -F: -v w="$wifi" '$2==w {print $1}')
                    if [[ -n "$wifi_iface" ]]; then
                        wifi_ip=$(ip -brief addr show "$wifi_iface" 2>/dev/null | awk '{print $3}' | cut -d/ -f1 | head -n1)
                        if [[ -n "$wifi_ip" ]]; then
                            info "Testing" "$wifi ($wifi_ip)"
                            
                            ip rule add from "$wifi_ip" table 100 2>/dev/null
                            ip route flush table 100 2>/dev/null
                            ip route show dev "$wifi_iface" 2>/dev/null | grep -v 'default' | while read -r route_line; do
                                ip route add $route_line table 100 2>/dev/null
                            done
                            wifi_gw=$(ip -4 route show dev "$wifi_iface" | awk '/default/ {print $3; exit}')
                            if [[ -n "$wifi_gw" ]]; then
                                ip route add default via "$wifi_gw" dev "$wifi_iface" table 100 2>/dev/null
                            fi
                            
                            info "Ping Check" "Verifying server via $wifi_iface..."
                            if iperf3 -c "$IPERF_SERVER" --bind "$wifi_ip" -n 1K >/dev/null 2>&1; then
                                DL_OUT="$(iperf3 --client "$IPERF_SERVER" --bind "$wifi_ip" --time 15 --format m --reverse 2>&1)"
                                DL_VAL="$(echo "$DL_OUT" | awk '/receiver/ {print $(NF-2) " " $(NF-1)}')"
                                [[ -n "$DL_VAL" ]] && info "Download" "$DL_VAL" || info "Download" "FAILED"
                                
                                UL_OUT="$(iperf3 --client "$IPERF_SERVER" --bind "$wifi_ip" --time 15 --format m 2>&1)"
                                UL_VAL="$(echo "$UL_OUT" | awk '/receiver/ {print $(NF-2) " " $(NF-1)}')"
                                [[ -n "$UL_VAL" ]] && info "Upload" "$UL_VAL" || info "Upload" "FAILED"
                                
                                freq_mhz=$(iw dev "$wifi_iface" link 2>/dev/null | grep -i 'freq:' | awk '{print $2}')
                                label="[$wifi]"
                                if [[ -n "$freq_mhz" ]]; then
                                    if [[ $freq_mhz -lt 3000 ]]; then label="[$wifi (2.4GHz)]"
                                    else label="[$wifi (5GHz+)]"; fi
                                fi
                                echo "$label DL: ${DL_VAL:-FAILED} | UL: ${UL_VAL:-FAILED}" >> "$TEMP_ROOT/net_wifi_cycle"
                            else
                                warn "Server unreachable via $wifi, skipping benchmark."
                                echo "[$wifi] DL: SKIP (No Route) | UL: SKIP" >> "$TEMP_ROOT/net_wifi_cycle"
                            fi
                            
                            ip rule del from "$wifi_ip" table 100 2>/dev/null
                            ip route flush table 100 2>/dev/null
                        else
                            warn "No IP assigned to $wifi_iface"
                        fi
                    fi
                    if [[ "$was_active" -eq 0 ]]; then
                        info "Disconnecting" "$wifi"
                        nmcli connection down "$wifi" >/dev/null 2>&1
                    fi
                else
                    warn "Failed to connect to $wifi"
                fi
            done
        fi
    fi

fi

stop_cpu_monitor
print_monitor_summary "$MONITOR_FILE"

section_end

if [[ -f "$TEMP_ROOT/iperf_local_raw.txt" ]]; then
    echo
    echo "Raw iperf3 output (Local Loopback):"
    cat "$TEMP_ROOT/iperf_local_raw.txt" 2>/dev/null || true
fi

if [[ -n "$IPERF_SERVER" ]] && command_exists iperf3; then
    echo
    echo "Raw iperf3 output (TCP Download):"
    cat "$TEMP_ROOT/iperf_dl_raw.txt" 2>/dev/null || true
    echo
    echo "Raw iperf3 output (TCP Upload):"
    cat "$TEMP_ROOT/iperf_ul_raw.txt" 2>/dev/null || true
fi
print_cpu_monitor "$TEMP_ROOT/network_monitor.txt"
fi

###############################################################################
# 5.5 INTERNET BENCHMARK (SPEEDTEST)
###############################################################################

if [[ "$RUN_SPEEDTEST" -eq 1 ]]; then
    section "INTERNET BENCHMARK"
    
    IS_OOKLA=0
    if command_exists speedtest; then
        if speedtest --version 2>/dev/null | grep -qi "Ookla"; then
            IS_OOKLA=1
        fi
    fi
    
    if [[ "$IS_OOKLA" -eq 1 ]]; then
        info "Tool" "speedtest (Ookla)"
        info "Status" "Testing... (Please wait)"
        
        ST_CMD="speedtest --accept-license --accept-gdpr"
        if [[ -n "${ST_SERVER_ID:-}" ]]; then
            ST_CMD="$ST_CMD -s $ST_SERVER_ID"
        fi
        
        start_cpu_monitor "speedtest"
        SPEEDTEST_OUT="$($ST_CMD 2>/dev/null)"
        stop_cpu_monitor
        
        echo "$SPEEDTEST_OUT" > "$TEMP_ROOT/speedtest_raw.txt"
        
        ST_DL=$(echo "$SPEEDTEST_OUT" | sed -nE 's/.*Download:[ \t]*([0-9.]+[ \t]+[a-zA-Z/]+).*/\1/p')
        ST_UL=$(echo "$SPEEDTEST_OUT" | sed -nE 's/.*Upload:[ \t]*([0-9.]+[ \t]+[a-zA-Z/]+).*/\1/p')
        ST_PING=$(echo "$SPEEDTEST_OUT" | sed -nE 's/.*Latency:[ \t]*([0-9.]+[ \t]+ms).*/\1/p')
        ST_SERVER=$(echo "$SPEEDTEST_OUT" | sed -nE 's/^[ \t]*Server:[ \t]*(.*)/\1/p')
        ST_ISP=$(echo "$SPEEDTEST_OUT" | sed -nE 's/^[ \t]*ISP:[ \t]*(.*)/\1/p')
        ST_URL=$(echo "$SPEEDTEST_OUT" | awk '/Result URL:/ {print $3}')
        
        info "ISP" "${ST_ISP:-N/A}"
        info "Server" "${ST_SERVER:-N/A}"
        info "Latency" "${ST_PING:-N/A}"
        info "Download" "${ST_DL:-N/A}"
        info "Upload" "${ST_UL:-N/A}"
        info "Result URL" "${ST_URL:-N/A}"
        
        echo "$ST_DL" > "$TEMP_ROOT/net_st_dl"
        echo "$ST_UL" > "$TEMP_ROOT/net_st_ul"
        echo "${ST_ISP:-N/A}" > "$TEMP_ROOT/net_st_isp"
        echo "${ST_SERVER:-N/A}" > "$TEMP_ROOT/net_st_server"
        echo "${ST_URL:-N/A}" > "$TEMP_ROOT/net_st_url"
        
    elif command_exists speedtest-cli || command_exists speedtest; then
        # Use speedtest-cli if available, otherwise the 'speedtest' symlink
        ST_BIN="speedtest-cli"
        if ! command_exists speedtest-cli; then ST_BIN="speedtest"; fi
        
        info "Tool" "speedtest-cli"
        info "Status" "Testing... (Please wait)"
        
        ST_CMD="$ST_BIN --share"
        if [[ -n "${ST_SERVER_ID:-}" ]]; then
            ST_CMD="$ST_CMD --server $ST_SERVER_ID"
        fi
        
        start_cpu_monitor "speedtest"
        SPEEDTEST_OUT="$($ST_CMD 2>/dev/null)"
        stop_cpu_monitor
        
        echo "$SPEEDTEST_OUT" > "$TEMP_ROOT/speedtest_raw.txt"
        
        ST_DL=$(echo "$SPEEDTEST_OUT" | sed -nE 's/.*Download:[ \t]*([0-9.]+[ \t]+[a-zA-Z/]+).*/\1/p')
        ST_UL=$(echo "$SPEEDTEST_OUT" | sed -nE 's/.*Upload:[ \t]*([0-9.]+[ \t]+[a-zA-Z/]+).*/\1/p')
        ST_PING=$(echo "$SPEEDTEST_OUT" | grep "Hosted by" | awk -F': ' '{print $2}')
        ST_SERVER=$(echo "$SPEEDTEST_OUT" | grep "Hosted by" | sed 's/Hosted by //;s/: .*//')
        ST_ISP=$(echo "$SPEEDTEST_OUT" | grep "Testing from" | sed 's/Testing from //;s/ (.*//')
        ST_URL=$(echo "$SPEEDTEST_OUT" | grep "Share results:" | awk '{print $3}')
        
        info "ISP" "${ST_ISP:-N/A}"
        info "Server" "${ST_SERVER:-N/A}"
        info "Latency" "${ST_PING:-N/A}"
        info "Download" "${ST_DL:-N/A}"
        info "Upload" "${ST_UL:-N/A}"
        info "Result URL" "${ST_URL:-N/A}"
        
        echo "$ST_DL" > "$TEMP_ROOT/net_st_dl"
        echo "$ST_UL" > "$TEMP_ROOT/net_st_ul"
        echo "${ST_ISP:-N/A}" > "$TEMP_ROOT/net_st_isp"
        echo "${ST_SERVER:-N/A}" > "$TEMP_ROOT/net_st_server"
        echo "${ST_URL:-N/A}" > "$TEMP_ROOT/net_st_url"
    else
        fail "Could not install speedtest."
    fi
    
    # Print the environmental summary for the speedtest block
    print_monitor_summary "$MONITOR_FILE"
    
    section_end
    
    if [[ -f "$TEMP_ROOT/speedtest_raw.txt" ]]; then
        echo
        echo "Raw Speedtest output:"
        cat "$TEMP_ROOT/speedtest_raw.txt" 2>/dev/null || true
    fi
fi

