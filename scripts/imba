if [[ "$SWAP_TOTAL_MB" -gt 0 ]]; then
    SWAP_PERCENT=$((SWAP_USED_MB * 100 / SWAP_TOTAL_MB))
    if [[ "$SWAP_PERCENT" -ge 50 ]]; then
        warn "Swap usage is ${SWAP_PERCENT}%. Benchmark results may be affected."
    else
        info "Swap Check" "${SWAP_PERCENT}% (Optimal)"
    fi
else
    info "Swap Check" "No Swap configured."
