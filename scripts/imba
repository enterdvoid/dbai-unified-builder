section_end

###############################################################################
###############################################################################
# 8.5 JSON EXPORT
###############################################################################

if [[ "$EXPORT_JSON" -eq 1 ]]; then
    JSON_FILE="${EXPORT_DIR}/imba${BENCH_LABEL}_${SAFE_DEVICE_NAME}_${DATE_FILE}.json"
    # Helpers for strict JSON formatting
    num() {
        local val="$1"
        if [[ -z "$val" || "$val" == "SKIPPED" || "$val" == "FAILED" ]]; then
            echo "null"
            return
        fi
        local ext
        ext=$(echo "$val" | grep -oE '^[0-9]+(\.[0-9]+)?' | head -n1)
        echo "${ext:-null}"
    }
    fio_bw() {
        local val="$1"
        if [[ -z "$val" || "$val" == "SKIPPED" || "$val" == "FAILED" ]]; then
            echo "null"
            return
        fi
        local ext
        ext=$(echo "$val" | grep -oE '\([0-9.]+' | tr -d '(')
        echo "${ext:-null}"
    }
    str() {
        local val="$1"
        if [[ -z "$val" || "$val" == "N/A" ]]; then
            echo "null"
        else
            echo "\"$val\""
        fi
    }

    cat <<EOF > "$JSON_FILE"
{
  "device": "$DEVICE_MODEL",
  "soc": "$SOC_NAME",
  "os": "$OS_NAME",
  "kernel": "$(uname -r)",
  "cpu": {
    "single_core": $(num "$SINGLE_SCORE"),
    "all_core": $(num "$ALL_SCORE"),
    "threads": $(num "$THREADS_SCORE"),
    "mutex": $(num "$MUTEX_SCORE"),
    "clusters": {$(
        sep=""
        for f in "$TEMP_ROOT"/cluster_*_score; do
            [[ -f "$f" ]] || continue
            cl="$(basename "$f" | sed 's/cluster_//;s/_score//')"
            cs="$(cat "$f" 2>/dev/null)"
            [[ -n "$cs" ]] && printf '%s\n      "%s": %s' "$sep" "$cl" "$(num "$cs")"
            sep=","
        done
    )
    },
    "clockspeed_verified": {$(
        sep=""
        if [[ -f "$TEMP_ROOT/mhz_results.txt" ]]; then
            while IFS=: read -r ml mo mr; do
                printf '%s\n      "%s": {"os_mhz": %s, "real_mhz": %s}' "$sep" "$ml" "$(num "$mo")" "$(num "$mr")"
                sep=","
            done < "$TEMP_ROOT/mhz_results.txt"
        fi
    )
    }
  },
  "memory": {
    "read_mibps": $(num "$MEM_READ"),
    "write_mibps": $(num "$MEM_WRITE")
  },
  "storage": {
    "devices": {$(
        sep=""
        for f in "$TEMP_ROOT"/storage_result_*; do
            [[ -f "$f" ]] || continue
            bn="$(basename "$f" | sed 's/storage_result_//')"
            IFS="|" read -r dev_type model size seq_val qd1_val qd32_val write_val < "$f"
            printf '%s\n      "%s": {"type": %s, "model": %s, "size": %s, "seq_read_iops": %s, "seq_read_mibps": %s, "rand_read_qd1_iops": %s, "rand_read_qd1_mibps": %s, "rand_read_qd32_iops": %s, "rand_read_qd32_mibps": %s, "rand_write_iops": %s, "rand_write_mibps": %s}' \
            "$sep" "$bn" "$(str "$dev_type")" "$(str "$model")" "$(str "$size")" \
            "$(num "$seq_val")" "$(fio_bw "$seq_val")" \
            "$(num "$qd1_val")" "$(fio_bw "$qd1_val")" \
            "$(num "$qd32_val")" "$(fio_bw "$qd32_val")" \
            "$(num "$write_val")" "$(fio_bw "$write_val")"
            sep=","
        done
    )
    }
  },
  "network": {
    "local_iperf3_loopback_mbps": $(num "$NET_LOCAL"),
    "local_iperf3_wifi_cycle_tests": $(
      if [[ -z "$NET_WIFI_CYCLE" ]]; then
          echo "[],"
      else
          echo "["
          sep=""
          while IFS= read -r line; do
              [[ -z "$line" ]] && continue
              printf '%s\n      "%s"' "$sep" "$line"
              sep=","
          done <<< "$NET_WIFI_CYCLE"
          echo -e "\n    ],"
      fi
    )
    "local_iperf3_interfaces": {
      "${NET_IFACE:-unknown}": {
        "download_mbps": $(num "$NET_DL"),
        "upload_mbps": $(num "$NET_UL")
      }
    },
    "internet_speedtest": {
      "download_mbps": $(num "$NET_ST_DL"),
      "upload_mbps": $(num "$NET_ST_UL"),
      "isp": $(str "$NET_ST_ISP"),
      "server": $(str "$NET_ST_SERVER"),
      "url": $(str "$NET_ST_URL")
    }
  },
  "realworld": {$(
      sep=""
      if [[ -f "$TEMP_ROOT/rw_video_res" ]]; then
          IFS="|" read -r v_fps v_time < "$TEMP_ROOT/rw_video_res"
          printf '\n    "video_4k_1080p_fps": %s,\n    "video_4k_1080p_time_s": %s' "$(num "$v_fps")" "$(num "$v_time")"
          sep=","
      fi
      if [[ -f "$TEMP_ROOT/rw_audio_res" ]]; then
          IFS="|" read -r a_speed a_time < "$TEMP_ROOT/rw_audio_res"
          printf '%s\n    "audio_aac_speed": %s,\n    "audio_aac_time_s": %s' "$sep" "$(num "$a_speed")" "$(num "$a_time")"
      fi
      echo
  )},
  "power": {
    "enabled": $([ "$POWER_MONITOR_ENABLED" -eq 1 ] && echo "true" || echo "false"),
    "source": $(str "AC Wall Power (Home Assistant)"),
    "entity": $(str "$HA_POWER_ENTITY"),
    "idle_watts": $(num "$(cat "$TEMP_ROOT/idle_power" 2>/dev/null)"),
    "avg_watts": $(num "$(cat "$TEMP_ROOT/last_power_avg" 2>/dev/null)"),
    "max_watts": $(num "$(cat "$TEMP_ROOT/last_power_max" 2>/dev/null)"),
    "min_watts": $(num "$(cat "$TEMP_ROOT/last_power_min" 2>/dev/null)")
  }
}
EOF
fi

