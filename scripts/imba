section "SYSTEM INFORMATION"

OS_NAME="Unknown Linux"
if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    if [[ -n "${VERSION_ID:-}" ]] && [[ -n "${VERSION_CODENAME:-}" ]]; then
        OS_NAME="${NAME:-Unknown} ${VERSION_ID} (${VERSION_CODENAME})"
    else
        OS_NAME="${PRETTY_NAME:-Unknown Linux}"
    fi
fi

info "Device" "$DEVICE_MODEL"
if [[ "$SOC_NAME" != "Unknown SoC" ]]; then
    info "SoC" "$SOC_NAME"
fi
info "OS" "$OS_NAME"
info "Hostname" "$HOSTNAME_VALUE"
info "Kernel" "$(uname -r)"
info "Architecture" "$(uname -m)"

CPU_MODEL="$(lscpu 2>/dev/null | awk -F: '/Model name:/ {print $2}' | xargs)"
[[ -z "$CPU_MODEL" ]] && CPU_MODEL="Unknown"
info "CPU" "$(nproc)x $CPU_MODEL"

RAM_TOTAL_KB="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
RAM_AVAILABLE_KB="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
SWAP_TOTAL_KB="$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)"
SWAP_FREE_KB="$(awk '/^SwapFree:/ {print $2}' /proc/meminfo)"

RAM_TOTAL_MB=$((RAM_TOTAL_KB / 1024))
RAM_AVAILABLE_MB=$((RAM_AVAILABLE_KB / 1024))
SWAP_TOTAL_MB=$((SWAP_TOTAL_KB / 1024))
SWAP_FREE_MB=$((SWAP_FREE_KB / 1024))
SWAP_USED_MB=$((SWAP_TOTAL_MB - SWAP_FREE_MB))
SWAP_PCT=0
[[ "$SWAP_TOTAL_MB" -gt 0 ]] && SWAP_PCT=$((SWAP_USED_MB * 100 / SWAP_TOTAL_MB))

info "RAM" "${RAM_TOTAL_MB} MB"
info "Swap" "${SWAP_TOTAL_MB} MB | ${SWAP_PCT}% used"

ROOT_DEV="$(df -P / 2>/dev/null | tail -n 1 | awk '{print $1}')"
printf "| %-58s |\n" "Storage List"

for StorageDevice in /dev/mmcblk? ; do
    [[ -e "${StorageDevice}" ]] || continue
    if [[ -x /sys/block/${StorageDevice##*/}/device ]]; then
        pushd /sys/block/${StorageDevice##*/}/device >/dev/null || continue
        declare mmc_serial="" mmc_manfid="" mmc_oemid="" mmc_type="" mmc_name=""
        eval $(grep . * 2>/dev/null | grep -v uevent | sed -e 's/:/=/' -e 's/^/mmc_/' -e 's/\ //g')
        popd >/dev/null
        
        mmc_size=$(lsblk -b -n -d -o SIZE "$StorageDevice" 2>/dev/null | awk '{ printf "%.1fGB", $1 / 1073741824 }')
        
        Manufacturer="Unknown"
        case "${mmc_manfid,,}/${mmc_oemid,,}" in
            0x000001*) Manufacturer="Panasonic" ;;
            0x000002/0x544d) Manufacturer="Toshiba" ;;
            0x000003/0x5344|0x000003/0x5744) Manufacturer="SanDisk" ;;
            0x000011/0x0037|0x000011/0x0038) Manufacturer="AData" ;;
            0x000018/0x0000) Manufacturer="Kingston" ;;
            0x00001b/0x534d|0x000015/0x0100|0x000011/0x0100) Manufacturer="Samsung" ;;
            0x000027/0x5048) Manufacturer="Phison" ;;
            0x000028/0x4245) Manufacturer="Lexar" ;;
            0x000041/0x3432|0x000070/0x0100) Manufacturer="Kingston" ;;
            0x000073/0x0001|0x000073/0x4247) Manufacturer="Hama/Transcend" ;;
            0x000074/0x4a45) Manufacturer="Transcend" ;;
            0x00008c/0x0000|0x00008c/0x5352) Manufacturer="Strontium" ;;
            0x00008f/0x0000) Manufacturer="Sony" ;;
            0x00009c/0x534f) Manufacturer="Sony" ;;
            0x00009e/0x4749) Manufacturer="Lexar" ;;
            0x000090/0x014a) Manufacturer="SK Hynix" ;;
            0x0000fe/0x014e) Manufacturer="Micron" ;;
            0x000045/0x0100) Manufacturer="SanDisk" ;;
            0x000088/0x0100|0x000088/0x0103) Manufacturer="Foresee" ;;
            0x0000ad/0x4c53) Manufacturer="Longsys" ;;
            *) Manufacturer="Unknown (${mmc_manfid}/${mmc_oemid})" ;;
        esac
        
        type_str="Card"
        [[ "${mmc_type,,}" == "mmc" ]] && type_str="eMMC"
        [[ "${mmc_type,,}" == "sd" ]] && type_str="HS SD card"
        
        # Format nice description
        mmc_desc="${Manufacturer} ${mmc_name}"
        # Trim multiple spaces
        mmc_desc="$(echo "$mmc_desc" | xargs)"
        
        dev_name="${StorageDevice##*/}"
        left_str="${dev_name} ${mmc_size}"
        right_str="\"${mmc_desc}\" ${type_str}"
        
        if [[ -n "$ROOT_DEV" && "${ROOT_DEV}" == "${StorageDevice}"* ]]; then
            right_str="${right_str} (OS)"
        fi
        
        printf "| %-15s : %-40s |\n" "$left_str" "$right_str"
    fi
done

for StorageDevice in /dev/sd? ; do
    [[ -e "${StorageDevice}" ]] || continue
    if [[ -b "${StorageDevice}" ]]; then
        sd_size=$(lsblk -b -n -d -o SIZE "$StorageDevice" 2>/dev/null | awk '{ printf "%.1fGB", $1 / 1073741824 }')
        sd_model=$(cat /sys/block/${StorageDevice##*/}/device/model 2>/dev/null | xargs)
        sd_vendor=$(cat /sys/block/${StorageDevice##*/}/device/vendor 2>/dev/null | xargs)
        
        is_usb=0
        if readlink -f /sys/block/${StorageDevice##*/} 2>/dev/null | grep -q "usb"; then
            is_usb=1
        fi
        
        type_str="Drive"
        [[ "$is_usb" -eq 1 ]] && type_str="USB Drive"
        
        dev_name="${StorageDevice##*/}"
        left_str="${dev_name} ${sd_size}"
        right_str="\"${sd_vendor} ${sd_model}\" ${type_str}"
        
        # Trim spaces in quotes
        right_str="$(echo "$right_str" | sed 's/  */ /g')"
        
        if [[ -n "$ROOT_DEV" && "${ROOT_DEV}" == "${StorageDevice}"* ]]; then
            right_str="${right_str} (OS)"
        fi
        
        printf "| %-15s : %-40s |\n" "$left_str" "$right_str"
    fi
done

# Initialize Power Monitor (optional — requires IMBA_HA_URL, IMBA_HA_TOKEN, IMBA_HA_POWER_ENTITY)
if [[ -n "$HA_URL" && -n "$HA_TOKEN" && -n "$HA_POWER_ENTITY" ]]; then
    subsection "Power Monitor"
    init_power_monitor
    if [[ "$POWER_MONITOR_ENABLED" -eq 1 ]]; then
        IDLE_POWER="$(read_power)"
        if [[ -n "$IDLE_POWER" ]]; then
            info "Idle Power" "${IDLE_POWER} W (AC Wall)"
            echo "$IDLE_POWER" > "$TEMP_ROOT/idle_power"
        fi
    fi
fi

section_end

###############################################################################
# 2. CPU BENCHMARK
###############################################################################



find_temperature_sensor() {
    local zone
    local type
    for zone in /sys/class/thermal/thermal_zone*; do
        [[ -r "$zone/temp" ]] || continue
        type="$(cat "$zone/type" 2>/dev/null || echo unknown)"
        case "$type" in
            cpu*|CPU*|soc*|SOC*|*cpu*|*CPU*)
                echo "$zone"
                return
                ;;
        esac
    done
    for zone in /sys/class/thermal/thermal_zone*; do
        [[ -r "$zone/temp" ]] || continue
        echo "$zone"
        return
    done
}

read_temperature() {
    local zone="$1"
    local raw
    raw="$(cat "$zone/temp" 2>/dev/null || echo 0)"
    if [[ "$raw" =~ ^[0-9]+$ ]]; then
        awk "BEGIN { printf \"%.1f\", $raw / 1000 }"
    else
        echo "N/A"
    fi
}

TEMP_ZONE="$(find_temperature_sensor)"

# Capture idle temperature before any benchmarks start
if [[ -n "$TEMP_ZONE" ]]; then
    IDLE_TEMP="$(read_temperature "$TEMP_ZONE")"
    echo "$IDLE_TEMP" > "$TEMP_ROOT/idle_temp"
fi


read_cpu_frequency() {
    local cpu="$1"
    local file="/sys/devices/system/cpu/cpu${cpu}/cpufreq/scaling_cur_freq"
    if [[ -r "$file" ]]; then
        local value
        value="$(cat "$file" 2>/dev/null || echo 0)"
        if [[ "$value" =~ ^[0-9]+$ ]]; then
            echo "$((value / 1000))"
            return
        fi
    fi
    awk -v c="$cpu" '
        BEGIN { RS=""; FS="\n" }
        NR==c+1 {
            for (i=1; i<=NF; i++) {
                if ($i ~ /cpu MHz/) {
                    split($i,a,":")
                    printf "%.0f", a[2]
                    exit
                }
            }
        }
    ' /proc/cpuinfo 2>/dev/null
}

read_cpu_freq_range() {
    local policy="/sys/devices/system/cpu/cpufreq/policy0"
    local min_f max_f gov
    if [[ -r "$policy/cpuinfo_min_freq" ]]; then
        min_f=$(( $(cat "$policy/cpuinfo_min_freq") / 1000 ))
        max_f=$(( $(cat "$policy/cpuinfo_max_freq") / 1000 ))
        gov=$(cat "$policy/scaling_governor" 2>/dev/null || echo "unknown")
        echo "${min_f}-${max_f} MHz (governor: ${gov})"
    else
        echo "N/A"
    fi
}

MONITOR_FILE=""
MONITOR_PID=""

start_cpu_monitor() {
    local label="$1"
    MONITOR_FILE="$TEMP_ROOT/${label}_monitor.txt"
    : > "$MONITOR_FILE"
    (
        trap - EXIT INT TERM
        trap 'exit 0' TERM
        local start_ns now_ns elapsed temp line cpu freq cpu_count ram_used power_val
        cpu_count="$(nproc)"
        start_ns="$(date +%s%N)"
        echo "Time|Temp|Frequencies|RAM|Power" >> "$MONITOR_FILE"

        while true; do
            sleep "$TEMP_INTERVAL"
            now_ns="$(date +%s%N)"
            elapsed=$(((now_ns - start_ns) / 1000000000))
            temp="$(read_temperature "$TEMP_ZONE")"
            line=""
            for ((cpu=0; cpu<cpu_count; cpu++)); do
                freq="$(read_cpu_frequency "$cpu")"
                [[ -z "$freq" ]] && freq="N/A"
                if [[ -z "$line" ]]; then
                    line="CPU${cpu}=${freq}"
                else
                    line="${line},CPU${cpu}=${freq}"
                fi
            done
            ram_used="$(free -m | awk '/^Mem:/{print $3}')"
            power_val="$(read_power)"
            printf "%02d:%02d|%s|%s|%sMB|%s\n" "$((elapsed / 60))" "$((elapsed % 60))" "$temp" "$line" "$ram_used" "${power_val:-}" >> "$MONITOR_FILE"
        done
    ) &
    MONITOR_PID=$!
}

stop_cpu_monitor() {
    if [[ -n "$MONITOR_PID" ]]; then
        kill "$MONITOR_PID" 2>/dev/null || true
        wait "$MONITOR_PID" 2>/dev/null || true
        MONITOR_PID=""
    fi
}

print_cpu_monitor() {
    local file="$1"
    echo
    echo "  > Temperature / Frequency Monitoring"
    if [[ ! -s "$file" ]]; then
        echo "    No monitoring data."
        return
    fi
    if [[ "$POWER_MONITOR_ENABLED" -eq 1 ]]; then
        printf "%-8s %-10s %-10s %-10s %s\n" "Time" "Temp" "RAM" "Power" "CPU Frequency"
        tail -n +2 "$file" | while IFS='|' read -r time temp freq ram power; do
            local pwr_display="N/A"
            [[ -n "$power" && "$power" =~ ^[0-9] ]] && pwr_display="${power}W"
            printf "%-8s %-10s %-10s %-10s %s\n" "$time" "${temp} C" "${ram:-N/A}" "$pwr_display" "$freq"
        done
    else
        printf "%-8s %-10s %-10s %s\n" "Time" "Temp" "RAM" "CPU Frequency"
        tail -n +2 "$file" | while IFS='|' read -r time temp freq ram power; do
            printf "%-8s %-10s %-10s %s\n" "$time" "${temp} C" "${ram:-N/A}" "$freq"
        done
    fi
}

summarize_temperature() {
    local file="$1"
    local min="" max="" sum="0" count=0
    while IFS='|' read -r time temp freq; do
        [[ "$time" == "Time" ]] && continue
        [[ "$temp" == "N/A" ]] && continue
        if [[ "$temp" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
            if [[ -z "$min" ]] || awk "BEGIN {exit !($temp < $min)}"; then
                min="$temp"
            fi
            if [[ -z "$max" ]] || awk "BEGIN {exit !($temp > $max)}"; then
                max="$temp"
            fi
            sum="$(awk "BEGIN { printf \"%.3f\", $sum + $temp }")"
            count=$((count + 1))
        fi
    done < "$file"

    if [[ "$count" -gt 0 ]]; then
        local avg="$(awk "BEGIN { printf \"%.1f\", $sum / $count }")"
        info "Samples" "$count"
        info "Minimum" "${min} C"
        info "Maximum" "${max} C"
        info "Average" "${avg} C"
        echo "$avg" > "$TEMP_ROOT/last_temp_avg"
        echo "$max" > "$TEMP_ROOT/last_temp_max"
    else
        info "Samples" "0"
    fi
}

print_monitor_summary() {
    local file="$1"
    subsection "Temperature Summary"
    summarize_temperature "$file"
    summarize_frequency "$file"
    summarize_ram "$file"
    summarize_power "$file"
}

summarize_power() {
    local file="$1"
    [[ "$POWER_MONITOR_ENABLED" -ne 1 ]] && return

    subsection "Power Summary"
    local values min max avg count

    values="$(tail -n +2 "$file" 2>/dev/null | awk -F'|' '{print $5}' | grep -E '^[0-9]+(\.[0-9]+)?$')"
    if [[ -z "$values" ]]; then
        info "Status" "No power data collected"
        return
    fi

    count="$(echo "$values" | wc -l)"
    min="$(echo "$values" | sort -g | head -1)"
    max="$(echo "$values" | sort -g | tail -1)"
    avg="$(echo "$values" | awk '{sum+=$1; n++} END {if(n) printf "%.1f", sum/n}')"

    info "Samples" "$count"
    info "Minimum" "${min} W"
    info "Maximum" "${max} W"
    info "Average" "${avg} W"
    info "Source" "AC Wall Power (via Home Assistant)"

    echo "$avg" > "$TEMP_ROOT/last_power_avg"
    echo "$max" > "$TEMP_ROOT/last_power_max"
    echo "$min" > "$TEMP_ROOT/last_power_min"
}

summarize_ram() {
    local file="$1"
    local values avg min max
    subsection "RAM Usage Summary"

    if tail -n +2 "$file" 2>/dev/null | awk -F'|' '{print $4}' | grep -q 'MB'; then
        values="$(tail -n +2 "$file" | awk -F'|' '{print $4}' | tr -d 'MB')"
        if [[ -n "$values" ]]; then
            min="$(echo "$values" | sort -n | head -1)"
            max="$(echo "$values" | sort -n | tail -1)"
            avg="$(echo "$values" | awk '{sum+=$1; n++} END {if(n) printf "%.0f", sum/n}')"
            info "RAM Used" "min=${min} max=${max} avg=${avg} MB"
        else
            info "Status" "RAM usage data not available"
        fi
    else
        info "Status" "RAM usage data not available"
    fi
}

summarize_frequency() {
    local file="$1"
    local cpu values avg min max cpu_count has_freq_data
    cpu_count="$(nproc)"
    subsection "Frequency Summary"

    has_freq_data=0
    if tail -n +2 "$file" 2>/dev/null | grep -qE 'CPU[0-9]+=[0-9]'; then
        has_freq_data=1
    fi

    if [[ "$has_freq_data" -eq 0 ]]; then
        info "Status" "Live CPU frequency not available on this device"
        return
    fi

    for ((cpu=0; cpu<cpu_count; cpu++)); do
        values="$(
            tail -n +2 "$file" |
            awk -F'|' -v cpu="CPU${cpu}" '
                {
                    n=split($3,a,",")
                    for (i=1; i<=n; i++) {
                        split(a[i],b,"=")
                        if (b[1] == cpu && b[2] ~ /^[0-9]+$/) {
                            print b[2]
                        }
                    }
                }
            '
        )"
        if [[ -z "$values" ]]; then
            info "CPU${cpu}" "N/A"
            continue
        fi
        min="$(echo "$values" | sort -n | head -1)"
        max="$(echo "$values" | sort -n | tail -1)"
        avg="$(echo "$values" | awk '{sum+=$1; n++} END {if(n) printf "%.0f", sum/n}')"
        info "CPU${cpu}" "min=${min} max=${max} avg=${avg} MHz"
    done
}



if [[ "$RUN_CPU" -eq 1 ]]; then
section "CPU BENCHMARK"

CPU_FREQ_RANGE="$(read_cpu_freq_range)"
info "CPU Freq Range" "$CPU_FREQ_RANGE"

run_cpu_benchmark() {
    local label="$1"
    local threads="$2"
    local monitor_label

    subsection "$label"
    info "Threads" "$threads"
    info "Duration" "${CPU_DURATION} seconds"
    info "Temperature Interval" "${TEMP_INTERVAL} seconds"
    info "CPU Frequency Interval" "${FREQ_INTERVAL} seconds"

    if [[ -n "$TEMP_ZONE" ]]; then
        info "Temperature Sensor" "$TEMP_ZONE"
    else
        warn "No thermal sensor found."
    fi

    if [[ "$threads" -eq 1 ]]; then
        monitor_label="cpu_single"
    else
        monitor_label="cpu_all"
    fi

    start_cpu_monitor "$monitor_label"

    local sys_out
    sys_out="$(sysbench cpu \
        --threads="$threads" \
        --time="$CPU_DURATION" \
        --cpu-max-prime=20000 \
        run)"
    echo "$sys_out" > "$TEMP_ROOT/${monitor_label}_raw.txt"

    local score
    score="$(echo "$sys_out" | awk '/events per second:/ {print $NF}')"

    if [[ -n "$score" ]]; then
        info "Result" "${score} events/s"
        if [[ "$threads" -eq 1 ]]; then
            echo "$score" > "$TEMP_ROOT/single_score"
        else
            echo "$score" > "$TEMP_ROOT/all_score"
        fi
    else
        info "Result" "FAILED"
    fi

    stop_cpu_monitor

    print_monitor_summary "$MONITOR_FILE"

    if [[ -f "$TEMP_ROOT/last_temp_avg" ]]; then
        if [[ "$threads" -eq 1 ]]; then
            cp "$TEMP_ROOT/last_temp_avg" "$TEMP_ROOT/cpu_single_avg_temp"
        else
            cp "$TEMP_ROOT/last_temp_avg" "$TEMP_ROOT/cpu_all_avg_temp"
        fi
    fi
}

run_cpu_benchmark "Single Core" 1
run_cpu_benchmark "All Cores ($(nproc) threads)" "$(nproc)"

###############################################################################
# 2a. BIG.LITTLE CLUSTER DETECTION & PER-CLUSTER BENCHMARK
###############################################################################

detect_cpu_clusters() {
    # Detect unique CPU clusters via cpufreq policies
    # Each policy directory represents a distinct frequency domain (cluster)
    declare -gA CLUSTER_CORES=()      # CLUSTER_CORES[policy_id]="0 1 2 3"
    declare -gA CLUSTER_MAX_FREQ=()   # CLUSTER_MAX_FREQ[policy_id]="1800000"
    declare -ga CLUSTER_ORDER=()      # Sorted policy IDs (lowest freq first)

    local policy_dir="/sys/devices/system/cpu/cpufreq"
    if [[ ! -d "$policy_dir" ]]; then
        return 1
    fi

    local policy max_freq cores
    for policy in "$policy_dir"/policy*; do
        [[ -d "$policy" ]] || continue
        local policy_id="${policy##*/policy}"
        max_freq="$(cat "$policy/cpuinfo_max_freq" 2>/dev/null || echo 0)"
        cores="$(cat "$policy/related_cpus" 2>/dev/null || echo "")"
        [[ -z "$cores" ]] && continue

        CLUSTER_CORES[$policy_id]="$cores"
        CLUSTER_MAX_FREQ[$policy_id]="$max_freq"
    done

    # Need at least 2 clusters with different max frequencies for big.LITTLE
    if [[ ${#CLUSTER_CORES[@]} -lt 2 ]]; then
        return 1
    fi

    # Check if clusters actually have different max frequencies
    local unique_freqs
    unique_freqs="$(printf '%s\n' "${CLUSTER_MAX_FREQ[@]}" | sort -un | wc -l)"
    if [[ "$unique_freqs" -lt 2 ]]; then
        return 1
    fi

    # Sort clusters by max frequency (LITTLE first, big last)
    CLUSTER_ORDER=($(
        for pid in "${!CLUSTER_MAX_FREQ[@]}"; do
            echo "$pid ${CLUSTER_MAX_FREQ[$pid]}"
        done | sort -k2 -n | awk '{print $1}'
    ))

    return 0
}

get_cluster_label() {
    # Assign human-readable label based on position in sorted cluster list
    local idx="$1"
    local total="${#CLUSTER_ORDER[@]}"
    if [[ "$total" -eq 2 ]]; then
        if [[ "$idx" -eq 0 ]]; then echo "LITTLE"; else echo "big"; fi
    elif [[ "$total" -eq 3 ]]; then
        case "$idx" in
            0) echo "LITTLE" ;;
            1) echo "mid" ;;
            2) echo "big" ;;
        esac
    else
        echo "cluster$idx"
    fi
}

get_core_type_from_cpuinfo() {
    # Try to identify core type (e.g. Cortex-A53, Cortex-A73) from lscpu
    local cpu_id="$1"
    # On ARM, /sys/devices/system/cpu/cpu*/regs/identification/midr_el1 can help
    local midr_file="/sys/devices/system/cpu/cpu${cpu_id}/regs/identification/midr_el1"
    if [[ -r "$midr_file" ]]; then
        local midr
        midr="$(cat "$midr_file" 2>/dev/null)"
        # Extract part number (bits [15:4])
        local part_hex
        part_hex="$(printf '%03x' $(( (midr >> 4) & 0xFFF )) 2>/dev/null)"
        case "$part_hex" in
            d03) echo "Cortex-A53" ;;
            d04) echo "Cortex-A35" ;;
            d05) echo "Cortex-A55" ;;
            d07) echo "Cortex-A57" ;;
            d08) echo "Cortex-A72" ;;
            d09) echo "Cortex-A73" ;;
            d0a) echo "Cortex-A75" ;;
            d0b) echo "Cortex-A76" ;;
            d0d) echo "Cortex-A77" ;;
            d40) echo "Cortex-A76(N1)" ;;
            d41) echo "Cortex-A78" ;;
            d44) echo "Cortex-X1" ;;
            d46) echo "Cortex-A510" ;;
            d47) echo "Cortex-A710" ;;
            d48) echo "Cortex-X2" ;;
            d4d) echo "Cortex-A715" ;;
            d4e) echo "Cortex-X3" ;;
            *) echo "" ;;
        esac
    fi
}

IS_BIG_LITTLE=0
if detect_cpu_clusters; then
    IS_BIG_LITTLE=1

    subsection "CPU Topology (big.LITTLE)"
    info "Clusters" "${#CLUSTER_ORDER[@]}"

    for ((ci=0; ci<${#CLUSTER_ORDER[@]}; ci++)); do
        pid="${CLUSTER_ORDER[$ci]}"
        label="$(get_cluster_label "$ci")"
        cores_list="${CLUSTER_CORES[$pid]}"
        max_mhz="$(( ${CLUSTER_MAX_FREQ[$pid]} / 1000 ))"
        core_count="$(echo "$cores_list" | wc -w)"
        first_core="$(echo "$cores_list" | awk '{print $1}')"

        # Try to detect core type
        core_type="$(get_core_type_from_cpuinfo "$first_core")"
        type_suffix=""
        [[ -n "$core_type" ]] && type_suffix=" ($core_type)"

        info "$label" "${core_count} cores [${cores_list}] @ ${max_mhz} MHz${type_suffix}"
    done

    # Run per-cluster pinned benchmarks
    subsection "Per-Cluster Single Core Benchmark"
    for ((ci=0; ci<${#CLUSTER_ORDER[@]}; ci++)); do
        pid="${CLUSTER_ORDER[$ci]}"
        label="$(get_cluster_label "$ci")"
        cores_list="${CLUSTER_CORES[$pid]}"
        first_core="$(echo "$cores_list" | awk '{print $1}')"
        max_mhz="$(( ${CLUSTER_MAX_FREQ[$pid]} / 1000 ))"

        core_type="$(get_core_type_from_cpuinfo "$first_core")"
        type_suffix=""
        [[ -n "$core_type" ]] && type_suffix=" / $core_type"

        info "Testing" "${label} cluster (CPU${first_core}${type_suffix} @ ${max_mhz} MHz)"

        # Pin sysbench to the first core of this cluster
        cluster_out="$(taskset -c "$first_core" sysbench cpu \
            --threads=1 \
            --time="$CPU_DURATION" \
            --cpu-max-prime=20000 \
            run 2>/dev/null)"

        cluster_score="$(echo "$cluster_out" | awk '/events per second:/ {print $NF}')"

        if [[ -n "$cluster_score" ]]; then
            info "${label} Score" "${cluster_score} events/s"
            echo "$cluster_score" > "$TEMP_ROOT/cluster_${label}_score"
        else
            info "${label} Score" "FAILED"
        fi

        echo "$cluster_out" > "$TEMP_ROOT/cluster_${label}_raw.txt"
    done
fi

###############################################################################
# 2a2. REAL CLOCKSPEED VERIFICATION (mhz)
###############################################################################

MHZ_BIN="/tmp/imba-mhz/mhz"
CLOCKSPEED_FAKE=0
if [[ -x "$MHZ_BIN" ]] && command_exists taskset; then
    subsection "Real Clockspeed Verification"
    info "Tool" "mhz by Willy Tarreau (wtarreau)"

    if [[ "$IS_BIG_LITTLE" -eq 1 ]]; then
        # Measure each cluster separately
        for ((ci=0; ci<${#CLUSTER_ORDER[@]}; ci++)); do
            pid="${CLUSTER_ORDER[$ci]}"
            label="$(get_cluster_label "$ci")"
            cores_list="${CLUSTER_CORES[$pid]}"
            first_core="$(echo "$cores_list" | awk '{print $1}')"
            os_freq_khz="${CLUSTER_MAX_FREQ[$pid]}"
            os_freq_mhz="$(( os_freq_khz / 1000 ))"

            # Warm up first, then measure (3 runs, pick best)
            taskset -c "$first_core" "$MHZ_BIN" 1 1000000 >/dev/null 2>&1
            measured_raw="$(taskset -c "$first_core" "$MHZ_BIN" 3 1000000 2>/dev/null \
                | awk -F'cpu_MHz=' '{print $2}' | awk '{print $1}' | sort -rn | head -1)"

            if [[ -n "$measured_raw" ]]; then
                measured_mhz="$(printf '%.0f' "$measured_raw" 2>/dev/null || echo "$measured_raw")"
                diff_pct="$(awk "BEGIN { d = ($os_freq_mhz - $measured_mhz) / $os_freq_mhz * 100; printf \"%.1f\", (d < 0 ? -d : d) }")"

                if awk "BEGIN { exit !($diff_pct > 5) }"; then
                    warn "${label}: OS reports ${os_freq_mhz} MHz but hardware measures ${measured_mhz} MHz (${diff_pct}% off)"
                    CLOCKSPEED_FAKE=1
                else
                    ok "${label}: ${measured_mhz} MHz verified (OS: ${os_freq_mhz} MHz)"
                fi
                echo "${label}:${os_freq_mhz}:${measured_mhz}" >> "$TEMP_ROOT/mhz_results.txt"
            else
                info "${label}" "Measurement failed"
            fi
        done
    else
        # Single cluster - measure on CPU 0
        os_freq_khz="$(cat /sys/devices/system/cpu/cpufreq/policy0/cpuinfo_max_freq 2>/dev/null || echo 0)"
        os_freq_mhz="$(( os_freq_khz / 1000 ))"

        taskset -c 0 "$MHZ_BIN" 1 1000000 >/dev/null 2>&1
        measured_raw="$(taskset -c 0 "$MHZ_BIN" 3 1000000 2>/dev/null \
            | awk -F'cpu_MHz=' '{print $2}' | awk '{print $1}' | sort -rn | head -1)"

        if [[ -n "$measured_raw" ]]; then
            measured_mhz="$(printf '%.0f' "$measured_raw" 2>/dev/null || echo "$measured_raw")"
            diff_pct="$(awk "BEGIN { d = ($os_freq_mhz - $measured_mhz) / $os_freq_mhz * 100; printf \"%.1f\", (d < 0 ? -d : d) }")"

            if awk "BEGIN { exit !($diff_pct > 5) }"; then
                warn "OS reports ${os_freq_mhz} MHz but hardware measures ${measured_mhz} MHz (${diff_pct}% off)"
                CLOCKSPEED_FAKE=1
            else
                ok "CPU0: ${measured_mhz} MHz verified (OS: ${os_freq_mhz} MHz)"
            fi
            echo "CPU0:${os_freq_mhz}:${measured_mhz}" >> "$TEMP_ROOT/mhz_results.txt"
        else
            info "CPU0" "Measurement failed"
        fi
    fi

    if [[ "$CLOCKSPEED_FAKE" -eq 1 ]]; then
        warn "FAKE CLOCKSPEED DETECTED! Benchmark results may be misleading."
        warn "The SoC firmware/bootloader is limiting actual CPU frequency."
    fi
fi

subsection "CPU Scaling"

SINGLE_SCORE="$(cat "$TEMP_ROOT/single_score" 2>/dev/null || echo "")"
ALL_SCORE="$(cat "$TEMP_ROOT/all_score" 2>/dev/null || echo "")"

if [[ "$SINGLE_SCORE" =~ ^[0-9]+([.][0-9]+)?$ ]] &&
   [[ "$ALL_SCORE" =~ ^[0-9]+([.][0-9]+)?$ ]]; then

    SCALE="$(awk "BEGIN { printf \"%.2f\", $ALL_SCORE / $SINGLE_SCORE }")"
    EFFICIENCY="$(awk "BEGIN { printf \"%.1f\", (($ALL_SCORE / $SINGLE_SCORE) / $(nproc)) * 100 }")"

    info "Single Core" "${SINGLE_SCORE} events/s"
    info "All Core" "${ALL_SCORE} events/s"
    info "Scaling" "${SCALE}x"
    info "Linear Scaling Efficiency" "${EFFICIENCY}%"

    echo "$SCALE" > "$TEMP_ROOT/cpu_scale"
    echo "$EFFICIENCY" > "$TEMP_ROOT/cpu_efficiency"
else
    info "Scaling" "FAILED"
fi

subsection "CPU Thermal Summary"

IDLE_TEMP_VALUE="N/A"
SINGLE_TEMP_VALUE="N/A"
ALL_TEMP_VALUE="N/A"

if [[ -f "$TEMP_ROOT/idle_temp" ]]; then
    IDLE_TEMP_VALUE="$(cat "$TEMP_ROOT/idle_temp")"
fi
if [[ -f "$TEMP_ROOT/cpu_single_avg_temp" ]]; then
    SINGLE_TEMP_VALUE="$(cat "$TEMP_ROOT/cpu_single_avg_temp")"
fi
if [[ -f "$TEMP_ROOT/cpu_all_avg_temp" ]]; then
    ALL_TEMP_VALUE="$(cat "$TEMP_ROOT/cpu_all_avg_temp")"
fi

info "Idle Temperature" "${IDLE_TEMP_VALUE} C"
info "Single Core Avg" "${SINGLE_TEMP_VALUE} C"
info "All Core Avg" "${ALL_TEMP_VALUE} C"

if [[ "$IDLE_TEMP_VALUE" != "N/A" ]] && [[ "$ALL_TEMP_VALUE" != "N/A" ]]; then
    TEMP_RISE="$(awk "BEGIN { printf \"%.1f\", $ALL_TEMP_VALUE - $IDLE_TEMP_VALUE }")"
    info "Idle -> All Core Rise" "+${TEMP_RISE} C"
fi

