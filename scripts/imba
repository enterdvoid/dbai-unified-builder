# Interactive Prompt for Sharing
# Sleep briefly to ensure 'tee' flushes the last output lines
sleep 0.5
echo ""
echo "=========================================================================="
echo "  [AI ANALYSIS] Upload this log to get a professional AI analysis         "
echo "=========================================================================="
read -r -p "Do you want to upload and share this result anonymously? [y/N] " response </dev/tty || true
if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "Uploading log to multiple services (please wait)..."
    url_dpaste_org="FAILED"
    url_dpaste_com="FAILED"
    url_cnet="FAILED"
    
    if command_exists curl; then
        url_dpaste_org="$(curl -s -m 15 -F "content=<$LOG_FILE" -F "format=url" https://dpaste.org/api/ | tr -d '\r\n')"
        url_dpaste_com="$(curl -s -m 15 -F "content=<$LOG_FILE" https://dpaste.com/api/v2/ | tr -d '\r\n')"
        url_cnet="$(curl -s -m 15 -F "file=@$LOG_FILE" https://paste.c-net.org/ | tr -d '\r\n')"
    fi
    
    [[ ! "$url_dpaste_org" =~ ^http ]] && url_dpaste_org="FAILED"
    [[ ! "$url_dpaste_com" =~ ^http ]] && url_dpaste_com="FAILED"
    [[ ! "$url_cnet" =~ ^http ]] && url_cnet="FAILED"
    
    echo "[OK] Upload process finished!"
    echo "dpaste.org:    $url_dpaste_org"
    echo "dpaste.com:    $url_dpaste_com"
    echo "c-net.org:     $url_cnet"
    echo ""
    
    # Pick the best valid URL for the AI prompt
    share_url=""
    for url in "$url_dpaste_org" "$url_dpaste_com" "$url_cnet"; do
        if [[ "$url" =~ ^http ]]; then
            share_url="$url"
            break
        fi
    done

    if [[ -n "$share_url" ]]; then
        echo "--------------------------------------------------------------------------"
        
        if [[ "$RUN_CPU" -eq 1 && "$RUN_MEM" -eq 1 && "$RUN_STORAGE" -eq 1 && "$RUN_NET" -eq 1 && "$RUN_REALWORLD" -eq 1 ]]; then
            echo " [AI] Thermal Context Assistant (Optional)                        "
            echo "--------------------------------------------------------------------------"
            echo "Untuk mendapatkan analisa suhu (Thermal) AI yang jauh lebih akurat,"
            read -r -p "apakah Anda ingin memasukkan informasi fisik sistem pendingin perangkat ini? [y/N]: " ask_thermal </dev/tty || true
            THERMAL_CONTEXT_TEXT=""
            if [[ "$ask_thermal" =~ ^([yY][eE][sS]|[yY])$ ]]; then
                echo ""
                echo "[1/3] Sistem Pendingin (Cooling System) yang menempel pada SoC:"
                echo "  1) Default Bawaan (Hanya heatsink pabrik, tanpa kipas)"
                echo "  2) Custom Passive (Heatsink yang lebih besar / modifikasi tanpa kipas)"
                echo "  3) Active Standar (Heatsink + Kipas kecil bawaan)"
                echo "  4) Extreme Active (Custom heatsink besar + Kipas ukuran PC 8cm/12cm)"
                read -r -p "Pilih [1-4]: " cool_choice </dev/tty || true
                
                echo ""
                echo "[2/3] Kondisi Casing (Enclosure) perangkat saat pengetesan:"
                echo "  1) Tertutup Rapat (Casing standar pabrik tanpa modifikasi)"
                echo "  2) Modifikasi Ventilasi (Casing dilubangi / ditambah sirkulasi udara buatan)"
                echo "  3) Telanjang / Open Air (Casing dibuka sepenuhnya / board telanjang)"
                read -r -p "Pilih [1-3]: " case_choice </dev/tty || true
                
                echo ""
                echo "[3/3] Suhu Ruangan (Ambient Room Temperature):"
                echo "  1) Ber-AC (Air Conditioned, Dingin ~20-24°C)"
                echo "  2) Normal / Suhu Ruang (Indoor Non-AC, ~25-30°C)"
                echo "  3) Panas / Ekstrem (Outdoor / Tanpa sirkulasi udara luar, >30°C)"
                read -r -p "Pilih [1-3]: " room_choice </dev/tty || true

                case "$cool_choice" in
                    1) cool_text="Default Bawaan (Hanya heatsink pabrik, tanpa kipas)" ;;
                    2) cool_text="Custom Passive (Heatsink yang lebih besar / modifikasi tanpa kipas)" ;;
                    3) cool_text="Active Standar (Heatsink + Kipas kecil bawaan)" ;;
                    4) cool_text="Extreme Active (Custom heatsink besar + Kipas ukuran PC 8cm/12cm)" ;;
                    *) cool_text="Unknown Cooling" ;;
                esac
                
                case "$case_choice" in
                    1) case_text="Tertutup Rapat (Casing standar pabrik tanpa modifikasi)" ;;
                    2) case_text="Modifikasi Ventilasi (Casing dilubangi / ditambah sirkulasi udara buatan)" ;;
                    3) case_text="Telanjang / Open Air (Casing dibuka sepenuhnya / board telanjang)" ;;
                    *) case_text="Unknown Enclosure" ;;
                esac
                
                case "$room_choice" in
                    1) room_text="Ber-AC (Air Conditioned, Dingin ~20-24°C)" ;;
                    2) room_text="Normal / Suhu Ruang (Indoor Non-AC, ~25-30°C)" ;;
                    3) room_text="Panas / Ekstrem (Outdoor / Tanpa sirkulasi udara luar, >30°C)" ;;
                    *) room_text="Unknown Ambient" ;;
                esac
                
                THERMAL_CONTEXT_TEXT="**Hardware Context Note for AI:** The user is running this benchmark using an [${cool_text}] cooling solution, with a [${case_text}] enclosure, operating in a [${room_text}] ambient temperature environment. Please take this physical thermodynamics profile into account when analyzing the thermal stability and thermal throttling of the device."
                
                echo ""
                echo "✅ Data Thermal Fisik berhasil dirangkum dan ditambahkan ke dalam prompt!"
                echo "--------------------------------------------------------------------------"
            fi
            
            echo " [AI] ChatGPT / Claude Analysis Prompt                            "
            echo "--------------------------------------------------------------------------"
            if [[ -f "$PROMPT_FILE" ]]; then
                PROMPT_OUT_FILE="${EXPORT_DIR}/imba${BENCH_LABEL}_${SAFE_DEVICE_NAME}_${DATE_FILE}_prompt.txt"
                cat "$PROMPT_FILE" | while IFS= read -r line; do
                    if [[ "$line" == *"{{URL_OR_LOG}}"* || "$line" == *"{{URL}}"* ]]; then
                        echo "$share_url"
                        if [[ -n "$THERMAL_CONTEXT_TEXT" ]]; then
                            echo ""
                            echo "$THERMAL_CONTEXT_TEXT"
                        fi
                    else
                        echo "$line"
                    fi
                done > "$PROMPT_OUT_FILE"
                
                echo "✅ AI Prompt has been successfully generated!"
                echo "Because your prompt is very detailed ($(wc -l < "$PROMPT_FILE") lines), it has been saved to:"
                echo "-> $PROMPT_OUT_FILE"
                echo ""
                echo "Please open that file, copy all its text, and paste it to ChatGPT or Claude."
            else
                echo "✅ Log successfully uploaded!"
                echo "Share URL: $share_url"
                echo ""
                echo "(Note: imba.prompt file was not found, so no prompt was automatically generated.)"
            fi
        else
            echo "✅ Log successfully uploaded!"
            echo "Share URL: $share_url"
            echo ""
            echo "(Catatan: Generator Prompt AI dilewati karena Anda hanya menjalankan sebagian"
            echo "tes. Prompt AI komprehensif hanya dibuat untuk sesi Benchmark Penuh)."
        fi
        echo "--------------------------------------------------------------------------"
    else
        echo "[FAILED] All uploads failed. Please share the log file manually."
    fi
fi

# Fix ownership of exported files if running via sudo
if [[ -n "${SUDO_USER:-}" ]]; then
    chown -R "$SUDO_USER:$SUDO_USER" "$EXPORT_DIR" 2>/dev/null || true
fi
if command -v screen >/dev/null 2>&1 && [[ "${STY:-}" == *"$SCREEN_NAME"* ]]; then
    echo ""
    read -r -p "Do you want to terminate the '$SCREEN_NAME' screen session? [Y/n] " kill_screen_response </dev/tty || true
    if [[ "$kill_screen_response" =~ ^([nN][oO]|[nN])$ ]]; then
        echo "Keeping screen session alive. Dropping to shell..."
        exec "${SHELL:-bash}"
    else
        echo "Terminating screen session..."
    fi
fi
